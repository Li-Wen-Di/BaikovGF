(* Beginning of Notebook Content *)
Notebook[{
Cell["Example: HQ Potential (Two Loop)", "Title",ExpressionUUID->"fbc35f62-3f6e-bb43-ba9d-f05d3ee4fb91"],

Cell["Load Package", "Section",ExpressionUUID->"5d8ed9a8-5f81-d341-9d27-8e84393ee073"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"7a8fd82a-f551-3b49-8177-15816031fd64"],

Cell["\<\
Get[FileNameJoin[{DirectoryName@NotebookDirectory[], \"BaikovGF\", \
\"BaikovGF.wl\"}]];

Needs[\"BaikovGF`\"];\
\>", "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"7dbca9bc-52de-b140-b08d-a500989803c2"],

Cell["Setup", "Section",ExpressionUUID->"08a87858-1a5a-7c43-8391-f358f7e63742"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"215678f5-4484-9c4f-b4d7-7f40607f23dc"],

Cell["\<\
(* Fix the numeric source powers used in this example. *)
sourcePowerRule = {a1 -> 2, a2 -> 2, a3 -> 2, a4 -> 2, a5 -> 2, a6 -> 2, a7 \
-> 1};

(* Build helper forms of the source powers from sourcePowerRule. *)
sourcePowerVectorPackage = {a1, a2, a3, a4, a5, a6, a7} /. sourcePowerRule;
sourcePowerVector = sourcePowerVectorPackage;
sourcePowerFileTag = StringRiffle[ToString /@ sourcePowerVector, \"_\"];
sourcePowerVarTag = StringRiffle[ToString /@ sourcePowerVector, \"$\"];

(* Set the powers for target1. *)
target1 = {1, 1, 1, 1, 0, 1, 1};

(* Build the Feynman-integral family object with loop momenta {l, r}, \
external momenta {p, v}, explicit propagators {SP[l, l], SP[r, r], SP[l - p, \
l - p], SP[-p + r, -p + r], SP[l - r, l - r], SP[l, v], SP[r, v]}, no \
auxiliary propagators, kinematic rules {SP[p, p] -> s, SP[p, v] -> u, SP[v, \
v] -> t}, and dimension symbol d. *)
family = CreateFeynmanIntegral[
  \"LoopMomenta\" -> {l, r},
  \"ExternalMomenta\" -> {p, v},
  \"Propagators\" -> {SP[l, l], SP[r, r], SP[l - p, l - p], SP[-p + r, -p + \
r], SP[l - r, l - r], SP[l, v], SP[r, v]},
  \"AuxiliaryPropagators\" -> {},
  \"KinematicRules\" -> {SP[p, p] -> s, SP[p, v] -> u, SP[v, v] -> t},
  \"DimensionSymbol\" -> d
];

(* Point to the FIRE coefficient file for this source powers. *)
fireSourceFile = FileNameJoin[{DirectoryName@NotebookDirectory[], \"tests\", \
\"fire_reference_cases\", \"hq_potential_2loop\", \"coefficients\", \
\"hq_potential_2loop__src_\" <> sourcePowerFileTag <> \".wl\"}];\
\>", "Input",
 CellLabel->"In[66]:=",ExpressionUUID->"67454e0c-44e0-7743-a813-0d9617964963"],

Cell["Representative TypeIII-like Target {1, 1, 1, 1, 0, 1, 1}", "Section",ExpressionUUID->"036c6036-5a8c-0a41-af5f-824d12130f90"],

Cell["\<\
This step builds the generating-function object for the selected target and \
returns the runtime after evaluation.\
\>", "Text",ExpressionUUID->"c7818c3a-cb3b-5640-a72d-27eae578f7c6"],

Cell[CellGroupData[{

Cell["\<\
{tBuild1, gf1} = BuildBaikovGeneratingFunction[family, target1] // \
AbsoluteTiming;
tBuild1\
\>", "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"90306503-b697-0b47-b134-1966aaf318e3"],

Cell[BoxData["0.0053875`"], "Output",
 CellChangeTimes->{3.986860210914135*^9},
 CellLabel->"Out[84]=",ExpressionUUID->"04e19af2-ade0-f641-b8c6-99cd5f95eed9"]
}, Open  ]],

Cell["\<\
t$26 <-> D1 = SP[l, l]
t$27 <-> D2 = SP[r, r]
t$28 <-> D3 = SP[l, l] - 2*SP[l, p] + SP[p, p]
t$29 <-> D4 = SP[p, p] - 2*SP[p, r] + SP[r, r]
t$30 <-> D5 = SP[l, l] - 2*SP[l, r] + SP[r, r]
t$31 <-> D6 = SP[l, v]
t$32 <-> D7 = SP[r, v]\
\>", "Text",ExpressionUUID->"d923af18-c67b-f749-a04d-ec0158e530ac"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"8a80f7f1-02b9-c54e-809f-7da0c713152d"],

Cell[CellGroupData[{

Cell["\<\
{tExtract1, raw1} = ExtractBaikovCoefficient[gf1, sourcePowerVectorPackage] \
// AbsoluteTiming;
tExtract1\
\>", "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"88f870c0-402e-e24f-8ce7-63f47e918ea4"],

Cell[BoxData["0.01536`"], "Output",
 CellChangeTimes->{3.9868602109345055`*^9},
 CellLabel->"Out[86]=",ExpressionUUID->"24063fbc-43b6-ad42-af2e-056a4a7417ce"]
}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"4456b264-ba42-2e40-a132-faefd1321e3e"],

Cell[CellGroupData[{

Cell["\<\
{tSimplify1, res1} = SimplifyBaikovCoefficient[raw1] // AbsoluteTiming;
tSimplify1\
\>", "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"0b3881cb-3e02-034e-9fa1-0bb70a51c9e1"],

Cell[BoxData["0.0012066`"], "Output",
 CellChangeTimes->{3.9868602109465065`*^9},
 CellLabel->"Out[88]=",ExpressionUUID->"493cbfbe-c8d5-4e4b-850b-0abc62a3b8ca"]
}, Open  ]],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"1523d707-c236-be4a-b5ec-2ec41bdb5e09"],

Cell[CellGroupData[{

Cell["\<\
{tCompare1, compare1} = (
  Get[fireSourceFile];
  fireCoeff1 = Symbol[\"hqPotentialTwoLoop$src$\" <> sourcePowerVarTag <> \
\"$to$1$1$1$1$0$1$1\"];
  Simplify[Cancel[Together[res1[\"Coefficient\"] - fireCoeff1]] == 0]
) // AbsoluteTiming;
<|\"Time\" -> tCompare1, \"MatchQ\" -> compare1|>\
\>", "Input",
 CellLabel->"In[89]:=",ExpressionUUID->"bbd38913-4abc-514c-a734-cda37be1a17d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0235359`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.986860210973152*^9},
 CellLabel->"Out[90]=",ExpressionUUID->"80716161-0e68-cc49-8c3e-724adc4c5dc4"]
}, Open  ]]
},
WindowSize->{1440, 778.5},
WindowMargins->{{-4.875, Automatic}, {Automatic, -4.875}},
WindowTitle->"Example: HQ Potential (Two Loop)",
Magnification:>1.1 Inherited,
