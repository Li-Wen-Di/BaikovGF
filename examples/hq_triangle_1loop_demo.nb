Notebook[{
Cell["Example: HQ Triangle (One Loop)", "Title",ExpressionUUID->"d16ca0a7-b16a-1a43-bf33-06f84d476a6f"],

Cell["Load Package", "Section",ExpressionUUID->"d82ddba9-c137-5c49-a7f3-965023c3aefc"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"65536b8f-92ca-fc41-83f8-854ce892fba7"],

Cell["\<\
Get[FileNameJoin[{DirectoryName@NotebookDirectory[], \"BaikovGF\", \
\"BaikovGF.wl\"}]];

Needs[\"BaikovGF`\"];\
\>", "Input",
 CellLabel->"In[91]:=",ExpressionUUID->"bb13668d-40ca-324a-969b-2512ad77f93f"],

Cell["Setup", "Section",ExpressionUUID->"e2957c03-aaf6-5241-a0e2-eb522543680c"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"4cf363d7-88e9-4346-bde3-9b1f1a9189d2"],

Cell["\<\
(* Fix the numeric source powers used in this example. *)
sourcePowerRule = {a1 -> 3, a2 -> 3, a3 -> 3};

(* Build helper forms of the source powers from sourcePowerRule. *)
sourcePowerVectorPackage = {a1, a2, a3} /. sourcePowerRule;
sourcePowerVector = sourcePowerVectorPackage;
sourcePowerFileTag = StringRiffle[ToString /@ sourcePowerVector, \"_\"];
sourcePowerVarTag = StringRiffle[ToString /@ sourcePowerVector, \"$\"];

(* Set the powers for target1. *)
target1 = {1, 1, 1};

(* Set the powers for target2. *)
target2 = {1, 1, 0};

(* Build the Feynman-integral family object with loop momenta {l}, external \
momenta {p, v}, explicit propagators {SP[l, l], SP[l + p, l + p], SP[l, v]}, \
no auxiliary propagators, kinematic rules {SP[p, p] -> s, SP[p, v] -> u, \
SP[v, v] -> t}, and dimension symbol d. *)
family = CreateFeynmanIntegral[
  \"LoopMomenta\" -> {l},
  \"ExternalMomenta\" -> {p, v},
  \"Propagators\" -> {SP[l, l], SP[l + p, l + p], SP[l, v]},
  \"AuxiliaryPropagators\" -> {},
  \"KinematicRules\" -> {SP[p, p] -> s, SP[p, v] -> u, SP[v, v] -> t},
  \"DimensionSymbol\" -> d
];

(* Point to the FIRE coefficient file for this source powers. *)
fireSourceFile = FileNameJoin[{DirectoryName@NotebookDirectory[], \"tests\", \
\"fire_reference_cases\", \"hq_triangle_1loop\", \"coefficients\", \
\"hq_triangle_1loop__src_\" <> sourcePowerFileTag <> \".wl\"}];\
\>", "Input",
 CellLabel->"In[94]:=",ExpressionUUID->"ad34632a-757a-c048-bd9f-b99402907b7b"],

Cell["Top Target {1, 1, 1}", "Section",ExpressionUUID->"0c76fcbb-eaae-b640-8a02-891d606f11c2"],

Cell["\<\
This step builds the generating-function object for the selected target and \
returns the runtime after evaluation.\
\>", "Text",ExpressionUUID->"840a05c2-a5ef-9049-be73-43fec0726041"],

Cell[CellGroupData[{

Cell["\<\
{tBuild1, gf1} = BuildBaikovGeneratingFunction[family, target1] // \
AbsoluteTiming;
tBuild1\
\>", "Input",
 CellLabel->
  "In[114]:=",ExpressionUUID->"62fc052f-da33-ba47-a1e7-c2ecfc04c430"],

Cell[BoxData["0.0033263`"], "Output",
 CellChangeTimes->{3.9868602511018505`*^9},
 CellLabel->
  "Out[115]=",ExpressionUUID->"8e9032b5-9576-6f45-a9c2-2294b8c27ce8"]
}, Open  ]],

Cell["\<\
t$16 <-> D1 = SP[l, l]
t$17 <-> D2 = SP[l, l] + 2*SP[l, p] + SP[p, p]
t$18 <-> D3 = SP[l, v]\
\>", "Text",ExpressionUUID->"224df5f3-ff74-e54b-8427-8e31929733ce"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"6b2ef8c1-e2b5-5649-b455-82dac3e1c628"],

Cell[CellGroupData[{

Cell["\<\
{tExtract1, raw1} = ExtractBaikovCoefficient[gf1, sourcePowerVectorPackage] \
// AbsoluteTiming;
tExtract1\
\>", "Input",
 CellLabel->
  "In[116]:=",ExpressionUUID->"b1e96813-fe4a-8449-a663-3ccd6d6b8cbd"],

Cell[BoxData["0.0019365`"], "Output",
 CellChangeTimes->{3.9868602511163654`*^9},
 CellLabel->
  "Out[117]=",ExpressionUUID->"3d734f83-b0c1-c445-a040-4680a7185e1d"]
}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"aba5a9d2-853a-5f4d-ab40-1403690207e5"],

Cell[CellGroupData[{

Cell["\<\
{tSimplify1, res1} = SimplifyBaikovCoefficient[raw1] // AbsoluteTiming;
tSimplify1\
\>", "Input",
 CellLabel->
  "In[118]:=",ExpressionUUID->"ae21fecb-ae70-f449-9977-065008173f01"],

Cell[BoxData["0.0014418`"], "Output",
 CellChangeTimes->{3.9868602511298637`*^9},
 CellLabel->
  "Out[119]=",ExpressionUUID->"0522b177-b278-ee4f-96fb-8168fd8216f9"]
}, Open  ]],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"b8806dd3-8327-5548-ad80-67c40a26691e"],

Cell[CellGroupData[{

Cell["\<\
{tCompare1, compare1} = (
  Get[fireSourceFile];
  fireCoeff1 = Symbol[\"hqTriangleOneLoop$src$\" <> sourcePowerVarTag <> \
\"$to$1$1$1\"];
  Simplify[Cancel[Together[res1[\"Coefficient\"] - fireCoeff1]] == 0]
) // AbsoluteTiming;
<|\"Time\" -> tCompare1, \"MatchQ\" -> compare1|>\
\>", "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"591fe131-253a-694e-84ea-745a98c31802"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0017322`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9868602511428585`*^9},
 CellLabel->
  "Out[121]=",ExpressionUUID->"f9961e9b-8c03-5348-a780-b1ea56d9cb19"]
}, Open  ]],

Cell["Representative TypeII Target {1, 1, 0}", "Section",ExpressionUUID->"3d6a3c77-9f80-f74b-b765-7906140a9328"],

Cell["\<\
This step builds the generating-function object for the selected target and \
returns the runtime after evaluation.\
\>", "Text",ExpressionUUID->"616eabc4-f295-a54b-972c-b9723073ec3f"],

Cell[CellGroupData[{

Cell["\<\
{tBuild2, gf2} = BuildBaikovGeneratingFunction[family, target2] // \
AbsoluteTiming;
tBuild2\
\>", "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"c878774d-d737-344b-af03-0b478d1868c1"],

Cell[BoxData["0.026419`"], "Output",
 CellChangeTimes->{3.9868602511718483`*^9},
 CellLabel->
  "Out[123]=",ExpressionUUID->"06373275-1df5-6c4c-bd12-38a78cd5113e"]
}, Open  ]],

Cell["\<\
t$19 <-> D1 = SP[l, l]
t$20 <-> D2 = SP[l, l] + 2*SP[l, p] + SP[p, p]
t$21 <-> D3 = SP[l, v]\
\>", "Text",ExpressionUUID->"f8c8eac1-dab9-7f43-8964-85c583ee7364"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"cbc1a212-f9f0-f342-a4f0-00029c2c12e7"],

Cell[CellGroupData[{

Cell["\<\
{tExtract2, raw2} = ExtractBaikovCoefficient[gf2, sourcePowerVectorPackage] \
// AbsoluteTiming;
tExtract2\
\>", "Input",
 CellLabel->
  "In[124]:=",ExpressionUUID->"c32a653d-55a4-f944-990f-76f5e0c05b51"],

Cell[BoxData["0.0017385`"], "Output",
 CellChangeTimes->{3.986860251184849*^9},
 CellLabel->
  "Out[125]=",ExpressionUUID->"fb185477-2b98-ec4e-8b4e-cc1dda7a4bac"]
}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"13765e4c-dfba-6349-9cd4-09eec6e64512"],

Cell[CellGroupData[{

Cell["\<\
{tSimplify2, res2} = SimplifyBaikovCoefficient[raw2] // AbsoluteTiming;
tSimplify2\
\>", "Input",
 CellLabel->
  "In[126]:=",ExpressionUUID->"b83688e8-0686-664b-a8fd-e31505013bb3"],

Cell[BoxData["0.0010802`"], "Output",
 CellChangeTimes->{3.986860251188862*^9},
 CellLabel->
  "Out[127]=",ExpressionUUID->"ce1b4f7a-7555-fd4e-88d9-068ebf4e9d52"]
}, Open  ]],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"17f7697a-c25b-b640-8ec6-0d8f464727fe"],

Cell[CellGroupData[{

Cell["\<\
{tCompare2, compare2} = (
  Get[fireSourceFile];
  fireCoeff2 = Symbol[\"hqTriangleOneLoop$src$\" <> sourcePowerVarTag <> \
\"$to$1$1$0\"];
  Simplify[Cancel[Together[res2[\"Coefficient\"] - fireCoeff2]] == 0]
) // AbsoluteTiming;
<|\"Time\" -> tCompare2, \"MatchQ\" -> compare2|>\
\>", "Input",
 CellLabel->
  "In[128]:=",ExpressionUUID->"cfff0c3f-0dcc-b648-a340-f036a506365e"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0019366`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.986860251196348*^9},
 CellLabel->
  "Out[129]=",ExpressionUUID->"f7c9fa63-98f0-f244-b6f1-c452906dadd2"]
}, Open  ]]
},
