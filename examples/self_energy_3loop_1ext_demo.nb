Notebook[{
Cell["Example: Three-Loop Self-Energy (One External Momentum)", "Title",ExpressionUUID->"06c10dc7-31c6-7e40-a332-a762de98fe10"],

Cell["Load Package", "Section",ExpressionUUID->"84a719af-2a9f-3247-8f94-20ecb9a23a22"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"a79483e3-a7e3-7a47-a034-a68e6ca2b5be"],

Cell[BoxData[
 HoldComplete[Get[
    FileNameJoin[{
      DirectoryName[
       NotebookDirectory[]], "BaikovGF", "BaikovGF.wl"}]]; Null, Null, 
  Needs["BaikovGF`"]; Null]], "Input",ExpressionUUID->"b0e3f707-36b2-0945-\
9d32-7afcbe9bec9c"],

Cell["Setup", "Section",ExpressionUUID->"b6767998-ffee-124e-971e-4c03ff2339de"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"d594c909-12b4-654d-8905-7e10978d40c9"],

Cell[BoxData[
 HoldComplete[
 Null, $CellContext`sourcePowerRule = {$CellContext`a1 -> 1, $CellContext`a2 -> 
     1, $CellContext`a3 -> 2, $CellContext`a4 -> 2, $CellContext`a5 -> 
     2, $CellContext`a6 -> 2, $CellContext`a7 -> 2, $CellContext`a8 -> 
     2, $CellContext`a9 -> 0}; Null, Null, 
  Null, $CellContext`sourcePowerVectorPackage = 
   ReplaceAll[{$CellContext`a1, $CellContext`a2, $CellContext`a3, \
$CellContext`a4, $CellContext`a5, $CellContext`a6, $CellContext`a7, \
$CellContext`a8, $CellContext`a9}, $CellContext`sourcePowerRule]; Null, 
  Null, $CellContext`toOriginalPowerOrder[
     Pattern[$CellContext`v, 
      Blank[List]]] := 
   Module[{$CellContext`res = ConstantArray[0, 9]}, 
     Part[$CellContext`res, {1, 2, 3, 5, 6, 7, 8, 9}] = 
      Take[$CellContext`v, 8]; 
     Part[$CellContext`res, {4}] = 
      Take[$CellContext`v, -1]; $CellContext`res]; Null, 
  Null, $CellContext`sourcePowerVector = \
$CellContext`toOriginalPowerOrder[$CellContext`sourcePowerVectorPackage]; 
  Null, $CellContext`sourcePowerFileTag = StringRiffle[
     Map[ToString, $CellContext`sourcePowerVector], "_"]; 
  Null, $CellContext`sourcePowerVarTag = StringRiffle[
     Map[ToString, $CellContext`sourcePowerVector], "$"]; Null, Null, 
  Null, $CellContext`target1 = {1, 1, 1, 1, 1, 1, 1, 1, 0}; Null, Null, 
  Null, $CellContext`family = 
   BaikovGF`CreateFeynmanIntegral[
    "LoopMomenta" -> {$CellContext`l1, $CellContext`l2, $CellContext`l3}, 
     "ExternalMomenta" -> {$CellContext`p}, 
     "Propagators" -> {-$CellContext`m^2 + 
       BaikovGF`SP[$CellContext`l1, $CellContext`l1], -$CellContext`m^2 + 
       BaikovGF`SP[$CellContext`l2, $CellContext`l2], -$CellContext`m^2 + 
       BaikovGF`SP[$CellContext`l3, $CellContext`l3], -$CellContext`m^2 + 
       BaikovGF`SP[$CellContext`l2 - $CellContext`p, $CellContext`l2 - \
$CellContext`p], -$CellContext`m^2 + 
       BaikovGF`SP[$CellContext`l3 - $CellContext`p, $CellContext`l3 - \
$CellContext`p], -$CellContext`m^2 + 
       BaikovGF`SP[$CellContext`l1 - $CellContext`l2, $CellContext`l1 - \
$CellContext`l2], -$CellContext`m^2 + 
       BaikovGF`SP[$CellContext`l1 - $CellContext`l3, $CellContext`l1 - \
$CellContext`l3], -$CellContext`m^2 + 
       BaikovGF`SP[$CellContext`l2 - $CellContext`l3, $CellContext`l2 - \
$CellContext`l3]}, "AuxiliaryPropagators" -> {
       BaikovGF`SP[$CellContext`l1 - $CellContext`p, $CellContext`l1 - \
$CellContext`p]}, 
     "KinematicRules" -> {
      BaikovGF`SP[$CellContext`p, $CellContext`p] -> $CellContext`s}, 
     "DimensionSymbol" -> $CellContext`d]; Null, Null, 
  Null, $CellContext`fireSourceFile = FileNameJoin[{
      DirectoryName[
       NotebookDirectory[]], "tests", "fire_reference_cases", 
      "self_energy_3loop_1ext", "coefficients", 
      "self_energy_3loop_1ext__src_" <> $CellContext`sourcePowerFileTag <> 
      ".wl"}]; Null]], "Input",ExpressionUUID->"8b733d6e-b1ac-8543-a07e-\
b289ba24ca9e"],

Cell["Representative TypeI Target {1, 1, 1, 1, 1, 1, 1, 1, 0}", "Section",ExpressionUUID->"f150b617-eff7-6248-8a4c-a10180c0431c"],

Cell["\<\
This step builds the generating function for a representative TypeI target \
and returns the runtime.\
\>", "Text",ExpressionUUID->"cbbf884d-6094-db45-958b-60322ac1b376"],

Cell[BoxData[
 HoldComplete[{$CellContext`tBuild1, $CellContext`gf1} = AbsoluteTiming[
     BaikovGF`BuildBaikovGeneratingFunction[$CellContext`family, \
$CellContext`target1]]; Null, $CellContext`tBuild1]], "Input",ExpressionUUID->\
"54a086ba-22e2-834a-9d8d-95fd4deac456"],

Cell[BoxData["14.8362856`"], "Output",ExpressionUUID->"df643565-1ca1-dc4d-8791-ec1f6ad8e571"],

Cell["\<\
t-variable mapping for the generating function above:
t$126 <-> D1 = -m^2 + SP[l1, l1]
t$127 <-> D2 = -m^2 + SP[l2, l2]
t$128 <-> D3 = -m^2 + SP[l3, l3]
t$129 <-> D4 = -m^2 + SP[l2, l2] - 2*SP[l2, p] + SP[p, p]
t$130 <-> D5 = -m^2 + SP[l3, l3] - 2*SP[l3, p] + SP[p, p]
t$131 <-> D6 = -m^2 + SP[l1, l1] - 2*SP[l1, l2] + SP[l2, l2]
t$132 <-> D7 = -m^2 + SP[l1, l1] - 2*SP[l1, l3] + SP[l3, l3]
t$133 <-> D8 = -m^2 + SP[l2, l2] - 2*SP[l2, l3] + SP[l3, l3]

Only the explicit propagators carry t-variables in this TypeI generating \
function.\
\>", "Text",ExpressionUUID->"3d780e51-a8ee-4842-93ad-08ed6df5a13f"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime.\
\>", "Text",ExpressionUUID->"2ecbe761-c3b8-1b45-afc1-80507581d480"],

Cell[BoxData[
 HoldComplete[{$CellContext`tExtract1, $CellContext`raw1} = AbsoluteTiming[
     BaikovGF`ExtractBaikovCoefficient[$CellContext`gf1, 
      ReplaceAll[{$CellContext`a1, $CellContext`a2, $CellContext`a3, \
$CellContext`a4, $CellContext`a5, $CellContext`a6, $CellContext`a7, \
$CellContext`a8, $CellContext`a9}, $CellContext`sourcePowerRule]]]; 
  Null, $CellContext`tExtract1]], "Input",ExpressionUUID->"d576e519-97e3-fe41-\
918f-cc32f16fc659"],

Cell[BoxData["0.7271235`"], "Output",ExpressionUUID->"5690930c-e4b3-d248-b1c5-f17d58ea2cb5"],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime.\
\>", "Text",ExpressionUUID->"07a59985-cbfc-2a4f-b7c4-ae228bce7a33"],

Cell[BoxData[
 HoldComplete[{$CellContext`tSimplify1, $CellContext`res1} = AbsoluteTiming[
     BaikovGF`SimplifyBaikovCoefficient[$CellContext`raw1]]; 
  Null, $CellContext`tSimplify1]], "Input",ExpressionUUID->"3ab26b3f-3b9a-\
8144-8692-970c2a4d335b"],

Cell[BoxData["20.0069654`"], "Output",ExpressionUUID->"eb0185c7-73ec-2049-822b-483fc4adb773"],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"12261220-cbcb-f74e-9447-f817fb7faddb"],

Cell[BoxData[
 HoldComplete[{$CellContext`tCompare1, $CellContext`compare1} = 
   AbsoluteTiming[
    Get[$CellContext`fireSourceFile]; $CellContext`fireCoeff1 = 
      Symbol["selfEnergyThreeLoopOneExt$src$" <> \
$CellContext`sourcePowerVarTag <> "$to$1$1$1$0$1$1$1$1$1"]; Simplify[Cancel[
         Together[$CellContext`res1[
           "Coefficient"] - $CellContext`fireCoeff1]] == 0]]; Null, <|
  "Time" -> $CellContext`tCompare1, 
   "MatchQ" -> $CellContext`compare1|>]], "Input",ExpressionUUID->"f3fbeb59-\
08f3-2e40-938b-39a31cdb87dd"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0010518`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"7871a191-a531-b64a-a0e0-\
e5cc20edf4ce"]
},
