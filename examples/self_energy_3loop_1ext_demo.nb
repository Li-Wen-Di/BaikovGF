(* Beginning of Notebook Content *)
Notebook[{
Cell["Example: Three-Loop Self-Energy (One External Momentum)", "Title",ExpressionUUID->"1cce399b-2de6-714c-8adb-92e4d5c6ccef"],

Cell["Load Package", "Section",ExpressionUUID->"16ea3bbb-e63f-5b48-8cfc-2b973597a91e"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"4b632a14-d57c-4e49-8fbe-64b208bee0c3"],

Cell["\<\
Get[FileNameJoin[{DirectoryName@NotebookDirectory[], \"BaikovGF\", \
\"BaikovGF.wl\"}]];

Needs[\"BaikovGF`\"];\
\>", "Input",
 CellLabel->
  "In[130]:=",ExpressionUUID->"a1c5c785-e719-6149-9dd7-86138fa7e0b1"],

Cell["Setup", "Section",ExpressionUUID->"1ec5da9d-2929-fe42-b5e7-d30bace85529"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"c36645e8-98ca-d64a-a6de-b66a98cf051e"],

Cell["\<\
(* Fix the numeric source powers used in this example. *)
sourcePowerRule = {a1 -> 1, a2 -> 1, a3 -> 2, a4 -> 2, a5 -> 2, a6 -> 2, a7 \
-> 2, a8 -> 2, a9 -> 0};

(* Build helper forms of the source powers from sourcePowerRule. *)
sourcePowerVectorPackage = {a1, a2, a3, a4, a5, a6, a7, a8, a9} /. \
sourcePowerRule;
toOriginalPowerOrder[v_List] := Module[{res = ConstantArray[0, 9]},
  res[[{1, 2, 3, 5, 6, 7, 8, 9}]] = Take[v, 8];
  res[[{4}]] = Take[v, -1];
  res
];

sourcePowerVector = toOriginalPowerOrder[sourcePowerVectorPackage];
sourcePowerFileTag = StringRiffle[ToString /@ sourcePowerVector, \"_\"];
sourcePowerVarTag = StringRiffle[ToString /@ sourcePowerVector, \"$\"];

(* Set the powers for target1. *)
target1 = {1, 1, 1, 1, 1, 1, 1, 1, 0};

(* Build the Feynman-integral family object with loop momenta {l1, l2, l3}, \
external momenta {p}, explicit propagators {-m^2 + SP[l1, l1], -m^2 + SP[l2, \
l2], -m^2 + SP[l3, l3], -m^2 + SP[l2 - p, l2 - p], -m^2 + SP[l3 - p, l3 - p], \
-m^2 + SP[l1 - l2, l1 - l2], -m^2 + SP[l1 - l3, l1 - l3], -m^2 + SP[l2 - l3, \
l2 - l3]}, auxiliary propagators {SP[l1 - p, l1 - p]}, kinematic rules {SP[p, \
p] -> s}, and dimension symbol d. *)
family = CreateFeynmanIntegral[
  \"LoopMomenta\" -> {l1, l2, l3},
  \"ExternalMomenta\" -> {p},
  \"Propagators\" -> {-m^2 + SP[l1, l1], -m^2 + SP[l2, l2], -m^2 + SP[l3, \
l3], -m^2 + SP[l2 - p, l2 - p], -m^2 + SP[l3 - p, l3 - p], -m^2 + SP[l1 - l2, \
l1 - l2], -m^2 + SP[l1 - l3, l1 - l3], -m^2 + SP[l2 - l3, l2 - l3]},
  \"AuxiliaryPropagators\" -> {SP[l1 - p, l1 - p]},
  \"KinematicRules\" -> {SP[p, p] -> s},
  \"DimensionSymbol\" -> d
];

(* Point to the FIRE coefficient file for this source powers. *)
fireSourceFile = FileNameJoin[{DirectoryName@NotebookDirectory[], \"tests\", \
\"fire_reference_cases\", \"self_energy_3loop_1ext\", \"coefficients\", \
\"self_energy_3loop_1ext__src_\" <> sourcePowerFileTag <> \".wl\"}];\
\>", "Input",
 CellLabel->
  "In[133]:=",ExpressionUUID->"84f09cd2-7391-1344-8d64-efde685d66af"],

Cell["Representative TypeI Target {1, 1, 1, 1, 1, 1, 1, 1, 0}", "Section",ExpressionUUID->"4b56dafd-0830-c442-83f9-ca562f557369"],

Cell["\<\
This step builds the generating-function object for the selected target and \
returns the runtime after evaluation.\
\>", "Text",ExpressionUUID->"adfe1880-75c9-dd49-aa3e-f6175828b6be"],

Cell[CellGroupData[{

Cell["\<\
{tBuild1, gf1} = BuildBaikovGeneratingFunction[family, target1] // \
AbsoluteTiming;
tBuild1\
\>", "Input",
 CellLabel->
  "In[152]:=",ExpressionUUID->"67f2d9c1-da8f-bf4b-b6ca-b83fb1a23c9f"],

Cell[BoxData["0.0055938`"], "Output",
 CellChangeTimes->{3.986860282434881*^9},
 CellLabel->
  "Out[153]=",ExpressionUUID->"e3de566d-aa97-3946-9cc9-ca9f02a108eb"]
}, Open  ]],

Cell["\<\
t$40 <-> D1 = -m^2 + SP[l1, l1]
t$41 <-> D2 = -m^2 + SP[l2, l2]
t$42 <-> D3 = -m^2 + SP[l3, l3]
t$43 <-> D4 = -m^2 + SP[l2, l2] - 2*SP[l2, p] + SP[p, p]
t$44 <-> D5 = -m^2 + SP[l3, l3] - 2*SP[l3, p] + SP[p, p]
t$45 <-> D6 = -m^2 + SP[l1, l1] - 2*SP[l1, l2] + SP[l2, l2]
t$46 <-> D7 = -m^2 + SP[l1, l1] - 2*SP[l1, l3] + SP[l3, l3]
t$47 <-> D8 = -m^2 + SP[l2, l2] - 2*SP[l2, l3] + SP[l3, l3]\
\>", "Text",ExpressionUUID->"2be3c0e3-d075-fb46-9f43-f682d923c1a7"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"58a6e2e3-bc5d-c84c-a428-6af7f55d78af"],

Cell[CellGroupData[{

Cell["\<\
{tExtract1, raw1} = ExtractBaikovCoefficient[gf1, sourcePowerVectorPackage] \
// AbsoluteTiming;
tExtract1\
\>", "Input",
 CellLabel->
  "In[154]:=",ExpressionUUID->"e0736078-cef9-e94d-8016-bb009333af5a"],

Cell[BoxData["0.4087141`"], "Output",
 CellChangeTimes->{3.9868602828472004`*^9},
 CellLabel->
  "Out[155]=",ExpressionUUID->"a1af5aa3-b457-be43-8426-9fe983934f3b"]
}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"f8ee7de3-924e-2541-a559-11d01e6a9389"],

Cell[CellGroupData[{

Cell["\<\
{tSimplify1, res1} = SimplifyBaikovCoefficient[raw1] // AbsoluteTiming;
tSimplify1\
\>", "Input",
 CellLabel->
  "In[156]:=",ExpressionUUID->"a779baff-9b35-b34a-ae8d-0727d28cb11e"],

Cell[BoxData["0.0016207`"], "Output",
 CellChangeTimes->{3.9868602828606186`*^9},
 CellLabel->
  "Out[157]=",ExpressionUUID->"0dae081b-50b2-5f4b-8513-4a911554b9b8"]
}, Open  ]],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"3767563e-f58c-9b42-a2a7-7a813d8980f8"],

Cell[CellGroupData[{

Cell["\<\
{tCompare1, compare1} = (
  Get[fireSourceFile];
  fireCoeff1 = Symbol[\"selfEnergyThreeLoopOneExt$src$\" <> sourcePowerVarTag \
<> \"$to$1$1$1$0$1$1$1$1$1\"];
  Simplify[Cancel[Together[res1[\"Coefficient\"] - fireCoeff1]] == 0]
) // AbsoluteTiming;
<|\"Time\" -> tCompare1, \"MatchQ\" -> compare1|>\
\>", "Input",
 CellLabel->
  "In[158]:=",ExpressionUUID->"b4f825fa-4087-3148-9051-3202f5a47d5d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0010179`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.98686028286462*^9},
 CellLabel->
  "Out[159]=",ExpressionUUID->"9f26f30f-e193-7f4e-88dc-9a41213c52ac"]
}, Open  ]]
},
