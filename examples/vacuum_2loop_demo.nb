(* Beginning of Notebook Content *)
Notebook[{
Cell["Example: Two-Loop Vacuum", "Title",ExpressionUUID->"389d85ad-d480-c344-a766-1f1a839251e0"],

Cell["Load Package", "Section",ExpressionUUID->"08ad418d-1846-344f-bcf0-0381b25e74b6"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"2f4958d3-87b8-824c-b768-b33443a9e311"],

Cell["\<\
Get[FileNameJoin[{DirectoryName@NotebookDirectory[], \"BaikovGF\", \
\"BaikovGF.wl\"}]];

Needs[\"BaikovGF`\"];\
\>", "Input",
 CellLabel->
  "In[246]:=",ExpressionUUID->"e1fcf5df-2006-b645-9351-085274f12500"],

Cell["Setup", "Section",ExpressionUUID->"49a9603a-b479-2f4f-aa14-f6befa7f823f"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"03e3cfc8-8a70-e640-a0b5-5ce9deeebf7f"],

Cell["\<\
(* Fix the numeric source powers used in this example. *)
sourcePowerRule = {a1 -> 2, a2 -> 2, a3 -> 3};

(* Build helper forms of the source powers from sourcePowerRule. *)
sourcePowerVectorPackage = {a1, a2, a3} /. sourcePowerRule;
sourcePowerVector = sourcePowerVectorPackage;
sourcePowerFileTag = StringRiffle[ToString /@ sourcePowerVector, \"_\"];
sourcePowerVarTag = StringRiffle[ToString /@ sourcePowerVector, \"$\"];

(* Set the powers for target1. *)
target1 = {1, 1, 1};

(* Set the powers for target2. *)
target2 = {1, 1, 0};

(* Build the Feynman-integral family object with loop momenta {k1, k2}, \
external momenta {}, explicit propagators {-m1sq + SP[k1, k1], -m2sq + SP[k2, \
k2], -m3sq + SP[k1 + k2, k1 + k2]}, no auxiliary propagators, kinematic rules \
{}, and dimension symbol d. *)
family = CreateFeynmanIntegral[
  \"LoopMomenta\" -> {k1, k2},
  \"ExternalMomenta\" -> {},
  \"Propagators\" -> {-m1sq + SP[k1, k1], -m2sq + SP[k2, k2], -m3sq + SP[k1 + \
k2, k1 + k2]},
  \"AuxiliaryPropagators\" -> {},
  \"KinematicRules\" -> {},
  \"DimensionSymbol\" -> d
];

(* Point to the FIRE coefficient file for this source powers. *)
fireSourceFile = FileNameJoin[{DirectoryName@NotebookDirectory[], \"tests\", \
\"fire_reference_cases\", \"vacuum_2loop\", \"coefficients\", \
\"vacuum_2loop__src_\" <> sourcePowerFileTag <> \".wl\"}];\
\>", "Input",
 CellLabel->
  "In[249]:=",ExpressionUUID->"9d4e4803-5398-4642-a9ba-8586c6052f6e"],

Cell["Top Target {1, 1, 1}", "Section",ExpressionUUID->"2c8ab7c7-ca96-6a44-b01f-3a1a73faf1f9"],

Cell["\<\
This step builds the generating-function object for the selected target and \
returns the runtime after evaluation.\
\>", "Text",ExpressionUUID->"e58d3465-abea-d342-a608-7b35df04bbb1"],

Cell[CellGroupData[{

Cell["\<\
{tBuild1, gf1} = BuildBaikovGeneratingFunction[family, target1] // \
AbsoluteTiming;
tBuild1\
\>", "Input",
 CellLabel->
  "In[269]:=",ExpressionUUID->"bdfd6f65-535c-2343-8945-ef0f62798d62"],

Cell[BoxData["0.0032833`"], "Output",
 CellChangeTimes->{3.9868603846317368`*^9},
 CellLabel->
  "Out[270]=",ExpressionUUID->"71891ae7-0c8d-7b4d-ab42-9c16c13c8395"]
}, Open  ]],

Cell["\<\
t$18 <-> D1 = -m1sq + SP[k1, k1]
t$19 <-> D2 = -m2sq + SP[k2, k2]
t$20 <-> D3 = -m3sq + SP[k1, k1] + 2*SP[k1, k2] + SP[k2, k2]\
\>", "Text",ExpressionUUID->"2994b575-4505-0c4b-b034-5e3b7ba2598a"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"48b118a6-f1ab-d245-adab-88c36dc60d8f"],

Cell[CellGroupData[{

Cell["\<\
{tExtract1, raw1} = ExtractBaikovCoefficient[gf1, sourcePowerVectorPackage] \
// AbsoluteTiming;
tExtract1\
\>", "Input",
 CellLabel->
  "In[271]:=",ExpressionUUID->"af7e8c21-fef4-6141-ac36-7b21a5a79dff"],

Cell[BoxData["0.0014656`"], "Output",
 CellChangeTimes->{3.9868603846451645`*^9},
 CellLabel->
  "Out[272]=",ExpressionUUID->"cd66dd74-8a0c-7347-93fb-5cd181519990"]
}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"fead0a32-d755-1b43-9a6d-7d4680263024"],

Cell[CellGroupData[{

Cell["\<\
{tSimplify1, res1} = SimplifyBaikovCoefficient[raw1] // AbsoluteTiming;
tSimplify1\
\>", "Input",
 CellLabel->
  "In[273]:=",ExpressionUUID->"b57bf197-2567-f14a-bcd0-224d52776c16"],

Cell[BoxData["0.0013451`"], "Output",
 CellChangeTimes->{3.9868603846486645`*^9},
 CellLabel->
  "Out[274]=",ExpressionUUID->"a5e32c84-8452-d145-9615-583dd8c5f374"]
}, Open  ]],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"667f5f04-bda1-5b48-9ffb-0cd6a49a9ded"],

Cell[CellGroupData[{

Cell["\<\
{tCompare1, compare1} = (
  Get[fireSourceFile];
  fireCoeff1 = Symbol[\"vacuumTwoLoop$src$\" <> sourcePowerVarTag <> \
\"$to$1$1$1\"];
  Simplify[Cancel[Together[res1[\"Coefficient\"] - fireCoeff1]] == 0]
) // AbsoluteTiming;
<|\"Time\" -> tCompare1, \"MatchQ\" -> compare1|>\
\>", "Input",
 CellLabel->
  "In[275]:=",ExpressionUUID->"e08f5e09-34aa-a14e-a78f-aaef7c69a551"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0081335`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.986860384662689*^9},
 CellLabel->
  "Out[276]=",ExpressionUUID->"2f5836cd-3d36-ce44-9161-556862535aef"]
}, Open  ]],

Cell["Representative TypeII Target {1, 1, 0}", "Section",ExpressionUUID->"ff0a4613-1c36-a348-9948-5f8a33f73f89"],

Cell["\<\
This step builds the generating-function object for the selected target and \
returns the runtime after evaluation.\
\>", "Text",ExpressionUUID->"1ce8fa11-efd5-214d-8e7b-f2c136b2d374"],

Cell[CellGroupData[{

Cell["\<\
{tBuild2, gf2} = BuildBaikovGeneratingFunction[family, target2] // \
AbsoluteTiming;
tBuild2\
\>", "Input",
 CellLabel->
  "In[277]:=",ExpressionUUID->"5fc5884f-66ad-394e-ae93-93dde3b4e41b"],

Cell[BoxData["0.0214426`"], "Output",
 CellChangeTimes->{3.9868603846867275`*^9},
 CellLabel->
  "Out[278]=",ExpressionUUID->"4f1b2bc3-71d2-ce41-99cc-ec5db8671016"]
}, Open  ]],

Cell["\<\
t$21 <-> D1 = -m1sq + SP[k1, k1]
t$22 <-> D2 = -m2sq + SP[k2, k2]
t$23 <-> D3 = -m3sq + SP[k1, k1] + 2*SP[k1, k2] + SP[k2, k2]\
\>", "Text",ExpressionUUID->"41956a1c-3b1e-8f46-8619-de85b57733c4"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"602dc223-4f66-7846-8c5f-72e6cad34e23"],

Cell[CellGroupData[{

Cell["\<\
{tExtract2, raw2} = ExtractBaikovCoefficient[gf2, sourcePowerVectorPackage] \
// AbsoluteTiming;
tExtract2\
\>", "Input",
 CellLabel->
  "In[279]:=",ExpressionUUID->"100ffb34-fead-1947-9595-3699caebba53"],

Cell[BoxData["0.0019552`"], "Output",
 CellChangeTimes->{3.9868603847047462`*^9},
 CellLabel->
  "Out[280]=",ExpressionUUID->"7d614294-a689-0946-97ae-819dd628d4d1"]
}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"7379a47d-950e-e845-b76f-f3f3fc0e63ec"],

Cell[CellGroupData[{

Cell["\<\
{tSimplify2, res2} = SimplifyBaikovCoefficient[raw2] // AbsoluteTiming;
tSimplify2\
\>", "Input",
 CellLabel->
  "In[281]:=",ExpressionUUID->"4067b098-fb39-2348-a013-d306b09679a6"],

Cell[BoxData["0.0013795`"], "Output",
 CellChangeTimes->{3.986860384708748*^9},
 CellLabel->
  "Out[282]=",ExpressionUUID->"32a03963-c15e-1a45-8f12-74e608ba43ff"]
}, Open  ]],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"6b6d07b5-3a98-af4a-8f1c-0a7d33032fe8"],

Cell[CellGroupData[{

Cell["\<\
{tCompare2, compare2} = (
  Get[fireSourceFile];
  fireCoeff2 = Symbol[\"vacuumTwoLoop$src$\" <> sourcePowerVarTag <> \
\"$to$1$1$0\"];
  Simplify[Cancel[Together[res2[\"Coefficient\"] - fireCoeff2]] == 0]
) // AbsoluteTiming;
<|\"Time\" -> tCompare2, \"MatchQ\" -> compare2|>\
\>", "Input",
 CellLabel->
  "In[283]:=",ExpressionUUID->"4be1ee8b-09a5-af43-b79e-e9eda9357535"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0087991`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.986860384721798*^9},
 CellLabel->
  "Out[284]=",ExpressionUUID->"26e2a529-687e-334b-b546-1f93c462ef2c"]
}, Open  ]]
},
