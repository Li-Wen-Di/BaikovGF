(* Beginning of Notebook Content *)
Notebook[{
Cell["Example: Tadpole", "Title",ExpressionUUID->"79b79a2a-6789-4347-aaa9-0946009dc899"],

Cell["Load Package", "Section",ExpressionUUID->"73ad7ae0-a56e-3041-983a-7efcd48e1f26"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"3e73574e-6d6d-574c-944e-e02f9fb213ff"],

Cell["\<\
Get[FileNameJoin[{DirectoryName@NotebookDirectory[], \"BaikovGF\", \
\"BaikovGF.wl\"}]];

Needs[\"BaikovGF`\"];\
\>", "Input",
 CellLabel->
  "In[218]:=",ExpressionUUID->"8e2f025e-aca6-2e4c-bb6e-a6b067b3a13f"],

Cell["Setup", "Section",ExpressionUUID->"3474be5e-bc2b-ed44-9c4a-36990d3e41bd"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"43a5b2ec-5484-be4f-afb9-543cbb97fb9a"],

Cell["\<\
(* Fix the numeric source powers used in this example. *)
sourcePowerRule = {a1 -> 8};

(* Build helper forms of the source powers from sourcePowerRule. *)
sourcePowerVectorPackage = {a1} /. sourcePowerRule;
sourcePowerVector = sourcePowerVectorPackage;
sourcePowerFileTag = StringRiffle[ToString /@ sourcePowerVector, \"_\"];
sourcePowerVarTag = StringRiffle[ToString /@ sourcePowerVector, \"$\"];

(* Set the powers for target1. *)
target1 = {1};

(* Build the Feynman-integral family object with loop momenta {k1}, external \
momenta {}, explicit propagators {-m + SP[k1, k1]}, no auxiliary propagators, \
kinematic rules {}, and dimension symbol d. *)
family = CreateFeynmanIntegral[
  \"LoopMomenta\" -> {k1},
  \"ExternalMomenta\" -> {},
  \"Propagators\" -> {-m + SP[k1, k1]},
  \"AuxiliaryPropagators\" -> {},
  \"KinematicRules\" -> {},
  \"DimensionSymbol\" -> d
];

(* Point to the FIRE coefficient file for this source powers. *)
fireSourceFile = FileNameJoin[{DirectoryName@NotebookDirectory[], \"tests\", \
\"fire_reference_cases\", \"tadpole\", \"coefficients\", \"tadpole__src_\" <> \
sourcePowerFileTag <> \".wl\"}];\
\>", "Input",
 CellLabel->
  "In[221]:=",ExpressionUUID->"871d9232-a82c-be4a-8539-67146a113e42"],

Cell["Top Target {1}", "Section",ExpressionUUID->"29a41173-1de8-bf45-a97f-8335ff84f576"],

Cell["\<\
This step builds the generating-function object for the selected target and \
returns the runtime after evaluation.\
\>", "Text",ExpressionUUID->"9079323c-bae3-1f4d-9af7-9cc75f49a5cd"],

Cell[CellGroupData[{

Cell["\<\
{tBuild1, gf1} = BuildBaikovGeneratingFunction[family, target1] // \
AbsoluteTiming;
tBuild1\
\>", "Input",
 CellLabel->
  "In[238]:=",ExpressionUUID->"64ec723e-778d-5d41-b56c-ec20dec5fabf"],

Cell[BoxData["0.0031979`"], "Output",
 CellChangeTimes->{3.986860373561064*^9},
 CellLabel->
  "Out[239]=",ExpressionUUID->"36c85ca3-72f7-2144-934c-a65a033e961e"]
}, Open  ]],

Cell["t$12 <-> D1 = -m + SP[k1, k1]", "Text",ExpressionUUID->"c56c93bf-8062-db46-b6b9-35d93f7eefdc"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"b7ea8e90-0e91-dc45-ac81-6da57e1598aa"],

Cell[CellGroupData[{

Cell["\<\
{tExtract1, raw1} = ExtractBaikovCoefficient[gf1, sourcePowerVectorPackage] \
// AbsoluteTiming;
tExtract1\
\>", "Input",
 CellLabel->
  "In[240]:=",ExpressionUUID->"9e2822e9-8c99-104c-9103-2956ef9f9627"],

Cell[BoxData["0.001173`"], "Output",
 CellChangeTimes->{3.9868603735660152`*^9},
 CellLabel->
  "Out[241]=",ExpressionUUID->"9fedce0b-e871-f14c-9943-1d71f953751d"]
}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"1ec8ea79-2e9f-8e42-982f-5c2204d9ba7e"],

Cell[CellGroupData[{

Cell["\<\
{tSimplify1, res1} = SimplifyBaikovCoefficient[raw1] // AbsoluteTiming;
tSimplify1\
\>", "Input",
 CellLabel->
  "In[242]:=",ExpressionUUID->"a541ae49-8a81-3941-915b-093b83a188ae"],

Cell[BoxData["0.0008973`"], "Output",
 CellChangeTimes->{3.9868603735695114`*^9},
 CellLabel->
  "Out[243]=",ExpressionUUID->"d083a74e-9db7-6347-9717-03c1dc3d54a0"]
}, Open  ]],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"46fc07fa-7166-4b4d-aaf6-285aeee301bf"],

Cell[CellGroupData[{

Cell["\<\
{tCompare1, compare1} = (
  Get[fireSourceFile];
  fireCoeff1 = Symbol[\"tadpoleOneLoop$src$\" <> sourcePowerVarTag <> \"$to$1\
\"];
  Simplify[Cancel[Together[res1[\"Coefficient\"] - fireCoeff1]] == 0]
) // AbsoluteTiming;
<|\"Time\" -> tCompare1, \"MatchQ\" -> compare1|>\
\>", "Input",
 CellLabel->
  "In[244]:=",ExpressionUUID->"9b68fb66-8f54-9e44-8121-aeabcbb22174"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0010995`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9868603735845127`*^9},
 CellLabel->
  "Out[245]=",ExpressionUUID->"04b14363-7d6c-b94d-8d86-2d89b47f75b7"]
}, Open  ]]
},
