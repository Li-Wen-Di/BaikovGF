(* Beginning of Notebook Content *)
Notebook[{
Cell["Example: Sunset 4-Propagator Family", "Title",ExpressionUUID->"eb7abb6d-bf9b-eb49-8526-322554306d02"],

Cell["Load Package", "Section",ExpressionUUID->"7c271ad0-f050-4741-ad7a-0487fe75a31f"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"cccda52d-5e30-8a40-b733-2983063d5e68"],

Cell[BoxData[
 HoldComplete[Get[
    FileNameJoin[{
      DirectoryName[
       NotebookDirectory[]], "BaikovGF", "BaikovGF.wl"}]]; Null, Null, 
  Needs["BaikovGF`"]; Null]], "Input",ExpressionUUID->"d7c857d5-d75f-8d4e-\
942b-8e9cf925c375"],

Cell["Setup", "Section",ExpressionUUID->"18b201a6-55c4-d646-822b-d4131da4ef24"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"1e4b97b9-b468-a246-9f46-3b02bb20b7ee"],

Cell[BoxData[
 HoldComplete[
 Null, $CellContext`sourcePowerRule = {$CellContext`a1 -> 3, $CellContext`a2 -> 
     3, $CellContext`a3 -> 4, $CellContext`a4 -> 4, $CellContext`a5 -> 0}; 
  Null, Null, 
  Null, $CellContext`sourcePowerVectorPackage = 
   ReplaceAll[{$CellContext`a1, $CellContext`a2, $CellContext`a3, \
$CellContext`a4, $CellContext`a5}, $CellContext`sourcePowerRule]; Null, 
  Null, $CellContext`toOriginalPowerOrder[
     Pattern[$CellContext`v, 
      Blank[List]]] := 
   Module[{$CellContext`res = ConstantArray[0, 5]}, 
     Part[$CellContext`res, {1, 3, 4, 5}] = Take[$CellContext`v, 4]; 
     Part[$CellContext`res, {2}] = 
      Take[$CellContext`v, -1]; $CellContext`res]; Null, 
  Null, $CellContext`sourcePowerVector = \
$CellContext`toOriginalPowerOrder[$CellContext`sourcePowerVectorPackage]; 
  Null, $CellContext`sourcePowerFileTag = StringRiffle[
     Map[ToString, $CellContext`sourcePowerVector], "_"]; 
  Null, $CellContext`sourcePowerVarTag = StringRiffle[
     Map[ToString, $CellContext`sourcePowerVector], "$"]; Null, Null, 
  Null, $CellContext`target1 = {1, 1, 1, 1, 0}; Null, Null, 
  Null, $CellContext`family = 
   BaikovGF`CreateFeynmanIntegral[
    "LoopMomenta" -> {$CellContext`k1, $CellContext`k2}, 
     "ExternalMomenta" -> {$CellContext`p1}, 
     "Propagators" -> {-$CellContext`m + 
       BaikovGF`SP[$CellContext`k1, $CellContext`k1], -$CellContext`m + 
       BaikovGF`SP[$CellContext`k2, $CellContext`k2], -$CellContext`m + 
       BaikovGF`SP[$CellContext`k2 + $CellContext`p1, $CellContext`k2 + \
$CellContext`p1], -$CellContext`m + 
       BaikovGF`SP[$CellContext`k1 + $CellContext`k2, $CellContext`k1 + \
$CellContext`k2]}, 
     "AuxiliaryPropagators" -> {-$CellContext`m + 
       BaikovGF`SP[$CellContext`k1 + $CellContext`p1, $CellContext`k1 + \
$CellContext`p1]}, 
     "KinematicRules" -> {
      BaikovGF`SP[$CellContext`p1, $CellContext`p1] -> $CellContext`s}, 
     "DimensionSymbol" -> $CellContext`d]; Null, Null, 
  Null, $CellContext`fireSourceFile = FileNameJoin[{
      DirectoryName[
       NotebookDirectory[]], "tests", "fire_reference_cases", "sunset_4prop", 
      "coefficients", "sunset_4prop__src_" <> $CellContext`sourcePowerFileTag <> 
      ".wl"}]; Null]], "Input",ExpressionUUID->"22389c6c-98f2-fb4d-826c-\
dea526fb9595"],

Cell["Representative TypeI Target {1, 1, 1, 1, 0}", "Section",ExpressionUUID->"7bda2306-ade1-3d46-a872-30041bcf79a8"],

Cell["\<\
This step builds the generating function for a representative TypeI target \
and returns the runtime.\
\>", "Text",ExpressionUUID->"cd6d1231-3d81-fe44-93bb-07e4762e0b05"],

Cell[BoxData[
 HoldComplete[{$CellContext`tBuild1, $CellContext`gf1} = AbsoluteTiming[
     BaikovGF`BuildBaikovGeneratingFunction[$CellContext`family, \
$CellContext`target1]]; Null, $CellContext`tBuild1]], "Input",ExpressionUUID->\
"6cdd7886-a14f-714f-be84-a0e7657cdea9"],

Cell[BoxData["1.0276981`"], "Output",ExpressionUUID->"74928b1a-5a36-b943-9a68-9b38e43e9393"],

Cell["\<\
t-variable mapping for the generating function above:
t$91 <-> D1 = -m + SP[k1, k1]
t$92 <-> D2 = -m + SP[k2, k2]
t$93 <-> D3 = -m + SP[k2, k2] + 2*SP[k2, p1] + SP[p1, p1]
t$94 <-> D4 = -m + SP[k1, k1] + 2*SP[k1, k2] + SP[k2, k2]

Only the explicit propagators carry t-variables in this TypeI generating \
function.\
\>", "Text",ExpressionUUID->"aec58fcc-a5a8-a046-a3c3-b63f6858cc2c"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime.\
\>", "Text",ExpressionUUID->"34e021ff-101d-ed4c-9a6d-f773d98bdbab"],

Cell[BoxData[
 HoldComplete[{$CellContext`tExtract1, $CellContext`raw1} = AbsoluteTiming[
     BaikovGF`ExtractBaikovCoefficient[$CellContext`gf1, 
      ReplaceAll[{$CellContext`a1, $CellContext`a2, $CellContext`a3, \
$CellContext`a4, $CellContext`a5}, $CellContext`sourcePowerRule]]]; 
  Null, $CellContext`tExtract1]], "Input",ExpressionUUID->"6a4c9cb1-2d66-f246-\
bda4-7f7833928cf1"],

Cell[BoxData["6.0135205`"], "Output",ExpressionUUID->"e1921e88-c093-b545-8e66-43f423b6c296"],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime.\
\>", "Text",ExpressionUUID->"0a208bb5-82fd-524a-b4b8-e0be184666eb"],

Cell[BoxData[
 HoldComplete[{$CellContext`tSimplify1, $CellContext`res1} = AbsoluteTiming[
     BaikovGF`SimplifyBaikovCoefficient[$CellContext`raw1]]; 
  Null, $CellContext`tSimplify1]], "Input",ExpressionUUID->"87a1f4ee-30b2-\
a24b-84d6-f00d56aedac6"],

Cell[BoxData["548.1144523`"], "Output",ExpressionUUID->"893d63c8-2fca-574a-b52a-6bc31e375b2c"],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"6dbfd0d5-c3b5-c24f-851d-f61f27cceca6"],

Cell[BoxData[
 HoldComplete[{$CellContext`tCompare1, $CellContext`compare1} = 
   AbsoluteTiming[
    Get[$CellContext`fireSourceFile]; $CellContext`fireCoeff1 = 
      Symbol["sunsetFourProp$src$" <> $CellContext`sourcePowerVarTag <> 
        "$to$1$0$1$1$1"]; Simplify[Cancel[
         Together[$CellContext`res1[
           "Coefficient"] - $CellContext`fireCoeff1]] == 0]]; Null, <|
  "Time" -> $CellContext`tCompare1, 
   "MatchQ" -> $CellContext`compare1|>]], "Input",ExpressionUUID->"d29098fe-\
bc41-b644-9af9-867edd3cdaa6"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0138498`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"6cb1ba03-e16a-1a4c-9db9-\
7db0b8d0df59"]
},
