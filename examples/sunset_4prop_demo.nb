(* Beginning of Notebook Content *)
Notebook[{
Cell["Example: Sunset 4-Propagator Family", "Title",ExpressionUUID->"e70266a9-c978-354d-b5d1-00541768145b"],

Cell["Load Package", "Section",ExpressionUUID->"5b7ec791-d119-784c-b14e-c0a5ae6e2246"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"d6e5ab10-8629-604b-87a7-0ce147ca4cd4"],

Cell["\<\
Get[FileNameJoin[{DirectoryName@NotebookDirectory[], \"BaikovGF\", \
\"BaikovGF.wl\"}]];

Needs[\"BaikovGF`\"];\
\>", "Input",
 CellLabel->
  "In[160]:=",ExpressionUUID->"812931cc-924e-f64c-ac7e-4c4e8942a82f"],

Cell["Setup", "Section",ExpressionUUID->"e9e705c0-60a4-bd4e-8aa6-fb02ad0de105"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"ca06d1df-9bba-944e-b478-7ff6b5494b85"],

Cell["\<\
(* Fix the numeric source powers used in this example. *)
sourcePowerRule = {a1 -> 3, a2 -> 3, a3 -> 4, a4 -> 4, a5 -> 0};

(* Build helper forms of the source powers from sourcePowerRule. *)
sourcePowerVectorPackage = {a1, a2, a3, a4, a5} /. sourcePowerRule;
toOriginalPowerOrder[v_List] := Module[{res = ConstantArray[0, 5]},
  res[[{1, 3, 4, 5}]] = Take[v, 4];
  res[[{2}]] = Take[v, -1];
  res
];

sourcePowerVector = toOriginalPowerOrder[sourcePowerVectorPackage];
sourcePowerFileTag = StringRiffle[ToString /@ sourcePowerVector, \"_\"];
sourcePowerVarTag = StringRiffle[ToString /@ sourcePowerVector, \"$\"];

(* Set the powers for target1. *)
target1 = {1, 1, 1, 1, 0};

(* Build the Feynman-integral family object with loop momenta {k1, k2}, \
external momenta {p1}, explicit propagators {-m + SP[k1, k1], -m + SP[k2, \
k2], -m + SP[k2 + p1, k2 + p1], -m + SP[k1 + k2, k1 + k2]}, auxiliary \
propagators {-m + SP[k1 + p1, k1 + p1]}, kinematic rules {SP[p1, p1] -> s}, \
and dimension symbol d. *)
family = CreateFeynmanIntegral[
  \"LoopMomenta\" -> {k1, k2},
  \"ExternalMomenta\" -> {p1},
  \"Propagators\" -> {-m + SP[k1, k1], -m + SP[k2, k2], -m + SP[k2 + p1, k2 + \
p1], -m + SP[k1 + k2, k1 + k2]},
  \"AuxiliaryPropagators\" -> {-m + SP[k1 + p1, k1 + p1]},
  \"KinematicRules\" -> {SP[p1, p1] -> s},
  \"DimensionSymbol\" -> d
];

(* Point to the FIRE coefficient file for this source powers. *)
fireSourceFile = FileNameJoin[{DirectoryName@NotebookDirectory[], \"tests\", \
\"fire_reference_cases\", \"sunset_4prop\", \"coefficients\", \
\"sunset_4prop__src_\" <> sourcePowerFileTag <> \".wl\"}];\
\>", "Input",
 CellLabel->
  "In[163]:=",ExpressionUUID->"c101944b-588e-9447-965b-e392ee6fb892"],

Cell["Representative TypeI Target {1, 1, 1, 1, 0}", "Section",ExpressionUUID->"26346b43-80eb-9b45-9816-7de438d943ad"],

Cell["\<\
This step builds the generating-function object for the selected target and \
returns the runtime after evaluation.\
\>", "Text",ExpressionUUID->"adc0e78c-0314-1048-bf07-770d8b53773f"],

Cell[CellGroupData[{

Cell["\<\
{tBuild1, gf1} = BuildBaikovGeneratingFunction[family, target1] // \
AbsoluteTiming;
tBuild1\
\>", "Input",
 CellLabel->
  "In[182]:=",ExpressionUUID->"3a7df839-1d12-c845-a63c-96509423ab86"],

Cell[BoxData["0.0041552`"], "Output",
 CellChangeTimes->{3.9868603445137196`*^9},
 CellLabel->
  "Out[183]=",ExpressionUUID->"bdb4ce35-07b6-f745-ab71-5b8e9e8e373d"]
}, Open  ]],

Cell["\<\
t$26 <-> D1 = -m + SP[k1, k1]
t$27 <-> D2 = -m + SP[k2, k2]
t$28 <-> D3 = -m + SP[k2, k2] + 2*SP[k2, p1] + SP[p1, p1]
t$29 <-> D4 = -m + SP[k1, k1] + 2*SP[k1, k2] + SP[k2, k2]\
\>", "Text",ExpressionUUID->"d8137b28-bd8d-7a45-8f3c-d4cd358b44a3"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"f49fef69-f786-2e43-822b-33fcbde5a9e9"],

Cell[CellGroupData[{

Cell["\<\
{tExtract1, raw1} = ExtractBaikovCoefficient[gf1, sourcePowerVectorPackage] \
// AbsoluteTiming;
tExtract1\
\>", "Input",
 CellLabel->
  "In[184]:=",ExpressionUUID->"755b97b9-78e2-434b-8895-a0ed6c22c96c"],

Cell[BoxData["3.4372118`"], "Output",
 CellChangeTimes->{3.986860347954048*^9},
 CellLabel->
  "Out[185]=",ExpressionUUID->"4d75c39d-0aee-2f44-a7b6-ff50af19ada5"]
}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"92053512-df14-344c-9635-14faa352e529"],

Cell[CellGroupData[{

Cell["\<\
{tSimplify1, res1} = SimplifyBaikovCoefficient[raw1] // AbsoluteTiming;
tSimplify1\
\>", "Input",
 CellLabel->
  "In[186]:=",ExpressionUUID->"6eb7efa0-5a8f-6c40-9973-a82215286db9"],

Cell[BoxData["0.001187`"], "Output",
 CellChangeTimes->{3.9868603479704247`*^9},
 CellLabel->
  "Out[187]=",ExpressionUUID->"52d62e5f-a34c-af4a-b403-8bf5f2abcbda"]
}, Open  ]],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"5cd51c0e-48dc-f54c-8dc6-3f656c1bc497"],

Cell[CellGroupData[{

Cell["\<\
{tCompare1, compare1} = (
  Get[fireSourceFile];
  fireCoeff1 = Symbol[\"sunsetFourProp$src$\" <> sourcePowerVarTag <> \
\"$to$1$0$1$1$1\"];
  Simplify[Cancel[Together[res1[\"Coefficient\"] - fireCoeff1]] == 0]
) // AbsoluteTiming;
<|\"Time\" -> tCompare1, \"MatchQ\" -> compare1|>\
\>", "Input",
 CellLabel->
  "In[188]:=",ExpressionUUID->"73bfaf32-4d28-344d-9428-fb830d6e77fd"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0190927`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.986860347995924*^9},
 CellLabel->
  "Out[189]=",ExpressionUUID->"155898ba-413f-dc4b-ba92-e95b22f14e34"]
}, Open  ]]
},
WindowSize->{1440, 778.5},
WindowMargins->{{-4.875, Automatic}, {Automatic, -4.875}},
WindowTitle->"Example: Sunset 4-Propagator Family",
Magnification:>1.1 Inherited,
