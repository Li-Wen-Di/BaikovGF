Notebook[{
Cell["Example: Three-Loop Vacuum", "Title",ExpressionUUID->"d241f59b-08b4-e340-9cae-75d5de30a2a3"],

Cell["Load Package", "Section",ExpressionUUID->"f63d2d15-1d4b-b247-a397-350dac12afc9"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"421fed28-161b-ec46-8aa9-96af91799cd3"],

Cell["\<\
Get[FileNameJoin[{DirectoryName@NotebookDirectory[], \"BaikovGF\", \
\"BaikovGF.wl\"}]];

Needs[\"BaikovGF`\"];\
\>", "Input",
 CellLabel->
  "In[285]:=",ExpressionUUID->"4dde37f1-9898-2d4e-bef7-c6b5a14764b8"],

Cell["Setup", "Section",ExpressionUUID->"dd360cac-d9d5-b648-96a9-0cbc0d8ad1bb"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"1147f65d-3875-544c-8276-9f412aaa1595"],

Cell["\<\
(* Fix the numeric source powers used in this example. *)
sourcePowerRule = {a1 -> 2, a2 -> 2, a3 -> 2, a4 -> 2, a5 -> 2, a6 -> 2};

(* Build helper forms of the source powers from sourcePowerRule. *)
sourcePowerVectorPackage = {a1, a2, a3, a4, a5, a6} /. sourcePowerRule;
sourcePowerVector = sourcePowerVectorPackage;
sourcePowerFileTag = StringRiffle[ToString /@ sourcePowerVector, \"_\"];
sourcePowerVarTag = StringRiffle[ToString /@ sourcePowerVector, \"$\"];

(* Set the powers for target1. *)
target1 = {1, 1, 1, 1, 1, 1};

(* Set the powers for target2. *)
target2 = {0, 1, 1, 1, 1, 1};

(* Set the powers for target3. *)
target3 = {1, 1, 1, 0, 1, 1};

(* Build the Feynman-integral family object with loop momenta {k1, k2, k3}, \
external momenta {}, explicit propagators {-m + SP[k1, k1], -m + SP[k2, k2], \
-m + SP[k3, k3], -m + SP[k1 - k2, k1 - k2], -m + SP[k2 - k3, k2 - k3], -m + \
SP[k1 - k3, k1 - k3]}, no auxiliary propagators, kinematic rules {}, and \
dimension symbol d. *)
family = CreateFeynmanIntegral[
  \"LoopMomenta\" -> {k1, k2, k3},
  \"ExternalMomenta\" -> {},
  \"Propagators\" -> {-m + SP[k1, k1], -m + SP[k2, k2], -m + SP[k3, k3], -m + \
SP[k1 - k2, k1 - k2], -m + SP[k2 - k3, k2 - k3], -m + SP[k1 - k3, k1 - k3]},
  \"AuxiliaryPropagators\" -> {},
  \"KinematicRules\" -> {},
  \"DimensionSymbol\" -> d
];

(* Point to the FIRE coefficient file for this source powers. *)
fireSourceFile = FileNameJoin[{DirectoryName@NotebookDirectory[], \"tests\", \
\"fire_reference_cases\", \"vacuum_3loop\", \"coefficients\", \
\"vacuum_3loop__src_\" <> sourcePowerFileTag <> \".wl\"}];\
\>", "Input",
 CellLabel->
  "In[288]:=",ExpressionUUID->"198a4bc6-9eeb-5d46-a1ed-cf1303ab3e4c"],

Cell["Top Target {1, 1, 1, 1, 1, 1}", "Section",ExpressionUUID->"5e3bcdaa-9275-0845-9bf4-435269727910"],

Cell["\<\
This step builds the generating-function object for the selected target and \
returns the runtime after evaluation.\
\>", "Text",ExpressionUUID->"99aca8cd-03b9-0d47-af71-e7d6dde7ab78"],

Cell[CellGroupData[{

Cell["\<\
{tBuild1, gf1} = BuildBaikovGeneratingFunction[family, target1] // \
AbsoluteTiming;
tBuild1\
\>", "Input",
 CellLabel->
  "In[311]:=",ExpressionUUID->"990d812f-0f28-084f-8992-d46e1ad43739"],

Cell[BoxData["0.0034024`"], "Output",
 CellChangeTimes->{3.986860397148201*^9},
 CellLabel->
  "Out[312]=",ExpressionUUID->"3bbdfd6f-3176-524b-b105-4d972905c981"]
}, Open  ]],

Cell["\<\
t$28 <-> D1 = -m + SP[k1, k1]
t$29 <-> D2 = -m + SP[k2, k2]
t$30 <-> D3 = -m + SP[k3, k3]
t$31 <-> D4 = -m + SP[k1, k1] - 2*SP[k1, k2] + SP[k2, k2]
t$32 <-> D5 = -m + SP[k2, k2] - 2*SP[k2, k3] + SP[k3, k3]
t$33 <-> D6 = -m + SP[k1, k1] - 2*SP[k1, k3] + SP[k3, k3]\
\>", "Text",ExpressionUUID->"424b488d-4480-2449-b16c-3ed72734550c"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"05e3721e-a209-694d-bcf5-06bfa1f454f3"],

Cell[CellGroupData[{

Cell["\<\
{tExtract1, raw1} = ExtractBaikovCoefficient[gf1, sourcePowerVectorPackage] \
// AbsoluteTiming;
tExtract1\
\>", "Input",
 CellLabel->
  "In[313]:=",ExpressionUUID->"e6997031-e5d4-364d-ac5d-34fc83eb5548"],

Cell[BoxData["0.0020097`"], "Output",
 CellChangeTimes->{3.9868603971618557`*^9},
 CellLabel->
  "Out[314]=",ExpressionUUID->"28d2af74-d899-3e40-bca1-14d6994e13b0"]
}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"cd18b170-5830-6a46-a0e2-f5402a2318bf"],

Cell[CellGroupData[{

Cell["\<\
{tSimplify1, res1} = SimplifyBaikovCoefficient[raw1] // AbsoluteTiming;
tSimplify1\
\>", "Input",
 CellLabel->
  "In[315]:=",ExpressionUUID->"a60a74ee-ae8d-2947-b1e0-5345b4a967c9"],

Cell[BoxData["0.0009084`"], "Output",
 CellChangeTimes->{3.986860397176956*^9},
 CellLabel->
  "Out[316]=",ExpressionUUID->"0df46e49-9c21-b541-a059-dc81aeed8cee"]
}, Open  ]],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"f1e334f6-f4c9-9b46-8024-fe9631b950e4"],

Cell[CellGroupData[{

Cell["\<\
{tCompare1, compare1} = (
  Get[fireSourceFile];
  fireCoeff1 = Symbol[\"vacuumThreeLoop$src$\" <> sourcePowerVarTag <> \
\"$to$1$1$1$1$1$1\"];
  Simplify[Cancel[Together[res1[\"Coefficient\"] - fireCoeff1]] == 0]
) // AbsoluteTiming;
<|\"Time\" -> tCompare1, \"MatchQ\" -> compare1|>\
\>", "Input",
 CellLabel->
  "In[317]:=",ExpressionUUID->"e35839b0-2c8f-ca44-a150-d19ebb68f2a5"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0034483`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.986860397190956*^9},
 CellLabel->
  "Out[318]=",ExpressionUUID->"a1240bcc-d0af-544e-8c70-39efbd07a0cb"]
}, Open  ]],

Cell["Representative TypeII Target {0, 1, 1, 1, 1, 1}", "Section",ExpressionUUID->"0cd47e54-b8ab-c743-9a6a-f97fd4224ea1"],

Cell["\<\
This step builds the generating-function object for the selected target and \
returns the runtime after evaluation.\
\>", "Text",ExpressionUUID->"651db346-0d7d-5745-9a09-c4c9357d7bcd"],

Cell[CellGroupData[{

Cell["\<\
{tBuild2, gf2} = BuildBaikovGeneratingFunction[family, target2] // \
AbsoluteTiming;
tBuild2\
\>", "Input",
 CellLabel->
  "In[319]:=",ExpressionUUID->"2dc7d386-2a1c-c64e-8be7-b204303942d8"],

Cell[BoxData["0.0344847`"], "Output",
 CellChangeTimes->{3.986860397228176*^9},
 CellLabel->
  "Out[320]=",ExpressionUUID->"a7a70ca5-b87b-d545-8091-33a2239ebfe2"]
}, Open  ]],

Cell["\<\
t$34 <-> D1 = -m + SP[k1, k1]
t$35 <-> D2 = -m + SP[k2, k2]
t$36 <-> D3 = -m + SP[k3, k3]
t$37 <-> D4 = -m + SP[k1, k1] - 2*SP[k1, k2] + SP[k2, k2]
t$38 <-> D5 = -m + SP[k2, k2] - 2*SP[k2, k3] + SP[k3, k3]
t$39 <-> D6 = -m + SP[k1, k1] - 2*SP[k1, k3] + SP[k3, k3]\
