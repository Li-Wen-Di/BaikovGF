Notebook[{
Cell["Example: Three-Loop Vacuum", "Title",ExpressionUUID->"3d0c3f30-383d-e141-a363-efc45b9d466d"],

Cell["Load Package", "Section",ExpressionUUID->"5e95b479-1ffc-7c48-a814-1b6b30a366c4"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"4cad0bdd-9769-7747-9689-d62d36788531"],

Cell[BoxData[
 HoldComplete[Get[
    FileNameJoin[{
      DirectoryName[
       NotebookDirectory[]], "BaikovGF", "BaikovGF.wl"}]]; Null, Null, 
  Needs["BaikovGF`"]; Null]], "Input",ExpressionUUID->"d42830ab-1bf8-2649-\
a3e0-0cd4146c65a5"],

Cell["Setup", "Section",ExpressionUUID->"c29778cd-6de5-3945-b9d7-471d51956ee6"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"4acfa7c9-992c-944a-87ef-5c778116e49e"],

Cell[BoxData[
 HoldComplete[
 Null, $CellContext`sourcePowerRule = {$CellContext`a1 -> 2, $CellContext`a2 -> 
     2, $CellContext`a3 -> 2, $CellContext`a4 -> 2, $CellContext`a5 -> 
     2, $CellContext`a6 -> 2}; Null, Null, 
  Null, $CellContext`sourcePowerVectorPackage = 
   ReplaceAll[{$CellContext`a1, $CellContext`a2, $CellContext`a3, \
$CellContext`a4, $CellContext`a5, $CellContext`a6}, \
$CellContext`sourcePowerRule]; 
  Null, $CellContext`sourcePowerVector = \
$CellContext`sourcePowerVectorPackage; 
  Null, $CellContext`sourcePowerFileTag = StringRiffle[
     Map[ToString, $CellContext`sourcePowerVector], "_"]; 
  Null, $CellContext`sourcePowerVarTag = StringRiffle[
     Map[ToString, $CellContext`sourcePowerVector], "$"]; Null, Null, 
  Null, $CellContext`target1 = {1, 1, 1, 1, 1, 1}; Null, Null, 
  Null, $CellContext`target2 = {0, 1, 1, 1, 1, 1}; Null, Null, 
  Null, $CellContext`target3 = {1, 1, 1, 0, 1, 1}; Null, Null, 
  Null, $CellContext`family = 
   BaikovGF`CreateFeynmanIntegral[
    "LoopMomenta" -> {$CellContext`k1, $CellContext`k2, $CellContext`k3}, 
     "ExternalMomenta" -> {}, 
     "Propagators" -> {-$CellContext`m + 
       BaikovGF`SP[$CellContext`k1, $CellContext`k1], -$CellContext`m + 
       BaikovGF`SP[$CellContext`k2, $CellContext`k2], -$CellContext`m + 
       BaikovGF`SP[$CellContext`k3, $CellContext`k3], -$CellContext`m + 
       BaikovGF`SP[$CellContext`k1 - $CellContext`k2, $CellContext`k1 - \
$CellContext`k2], -$CellContext`m + 
       BaikovGF`SP[$CellContext`k2 - $CellContext`k3, $CellContext`k2 - \
$CellContext`k3], -$CellContext`m + 
       BaikovGF`SP[$CellContext`k1 - $CellContext`k3, $CellContext`k1 - \
$CellContext`k3]}, "AuxiliaryPropagators" -> {}, "KinematicRules" -> {}, 
     "DimensionSymbol" -> $CellContext`d]; Null, Null, 
  Null, $CellContext`fireSourceFile = FileNameJoin[{
      DirectoryName[
       NotebookDirectory[]], "tests", "fire_reference_cases", "vacuum_3loop", 
      "coefficients", "vacuum_3loop__src_" <> $CellContext`sourcePowerFileTag <> 
      ".wl"}]; Null]], "Input",ExpressionUUID->"1f8cbbc3-f119-194d-8958-\
96ebc85235f3"],

Cell["Top Target {1, 1, 1, 1, 1, 1}", "Section",ExpressionUUID->"58345e20-ff1f-9647-aae3-b50621c51c58"],

Cell["\<\
This step builds the generating function for the top target and returns the \
runtime.\
\>", "Text",ExpressionUUID->"ff25f283-e6dd-4942-912a-f945475b9731"],

Cell[BoxData[
 HoldComplete[{$CellContext`tBuild1, $CellContext`gf1} = AbsoluteTiming[
     BaikovGF`BuildBaikovGeneratingFunction[$CellContext`family, \
$CellContext`target1]]; Null, $CellContext`tBuild1]], "Input",ExpressionUUID->\
"2083dc45-07ff-0944-a233-b807579b14fb"],

Cell[BoxData["0.0450111`"], "Output",ExpressionUUID->"ec8433cb-df8b-6845-b5f6-4c34472f1fcc"],

Cell["\<\
t-variable mapping for the generating function above:
t$61 <-> D1 = -m + SP[k1, k1]
t$62 <-> D2 = -m + SP[k2, k2]
t$63 <-> D3 = -m + SP[k3, k3]
t$64 <-> D4 = -m + SP[k1, k1] - 2*SP[k1, k2] + SP[k2, k2]
t$65 <-> D5 = -m + SP[k2, k2] - 2*SP[k2, k3] + SP[k3, k3]
t$66 <-> D6 = -m + SP[k1, k1] - 2*SP[k1, k3] + SP[k3, k3]\
\>", "Text",ExpressionUUID->"dc143ce8-0ce3-a84f-9676-a385f696a20d"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime.\
\>", "Text",ExpressionUUID->"12bc546c-6496-0441-971d-ab7796ce3ba5"],

Cell[BoxData[
 HoldComplete[{$CellContext`tExtract1, $CellContext`raw1} = AbsoluteTiming[
     BaikovGF`ExtractBaikovCoefficient[$CellContext`gf1, 
      ReplaceAll[{$CellContext`a1, $CellContext`a2, $CellContext`a3, \
$CellContext`a4, $CellContext`a5, $CellContext`a6}, \
$CellContext`sourcePowerRule]]]; Null, $CellContext`tExtract1]], "Input",Expre\
ssionUUID->"666f94d2-9f7a-4f49-9777-e85a6f5a4521"],

Cell[BoxData["0.0157841`"], "Output",ExpressionUUID->"ebeccc16-a78e-5447-9129-9ae7ebb62ffd"],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime.\
\>", "Text",ExpressionUUID->"937fa220-0f84-3a4a-958d-4f3af40fd756"],

Cell[BoxData[
 HoldComplete[{$CellContext`tSimplify1, $CellContext`res1} = AbsoluteTiming[
     BaikovGF`SimplifyBaikovCoefficient[$CellContext`raw1]]; 
  Null, $CellContext`tSimplify1]], "Input",ExpressionUUID->"b5613dd7-4bac-\
1747-af8b-79d2f6dfd657"],

Cell[BoxData["0.0170398`"], "Output",ExpressionUUID->"c5e4f121-30a1-284b-9985-4eaa6a0a45c3"],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"be5a6f79-5718-e147-9710-32b341580930"],

Cell[BoxData[
 HoldComplete[{$CellContext`tCompare1, $CellContext`compare1} = 
   AbsoluteTiming[
    Get[$CellContext`fireSourceFile]; $CellContext`fireCoeff1 = 
      Symbol["vacuumThreeLoop$src$" <> $CellContext`sourcePowerVarTag <> 
        "$to$1$1$1$1$1$1"]; Simplify[Cancel[
         Together[$CellContext`res1[
           "Coefficient"] - $CellContext`fireCoeff1]] == 0]]; Null, <|
