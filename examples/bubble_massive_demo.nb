}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime.\
\>", "Text",ExpressionUUID->"f5e1c357-59e2-7f4b-9276-cb3f85a5f8b4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tSimplify2", ",", "res2"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"SimplifyBaikovCoefficient", "[", "raw2", "]"}], "]"}]}], ";", 
  "tSimplify2"}]], "Input",
