Notebook[{
Cell["Example: Massive Bubble", "Title",ExpressionUUID->"9eeda8ee-82f5-4445-803a-d21c7bfc2bae"],

Cell["Load Package", "Section",ExpressionUUID->"03664c9a-0c24-e541-ab7c-6b188ef41825"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"b903a4a3-91e5-e34a-ab04-8232fdbf51c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Get", "[", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"DirectoryName", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ",", "\"\<BaikovGF\>\"",
       ",", "\"\<BaikovGF.wl\>\""}], "}"}], "]"}], "]"}], ";", 
  RowBox[{"Needs", "[", "\"\<BaikovGF`\>\"", "]"}], ";"}]], "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"320b999f-f3e8-7745-968c-2553950f6c58"],

Cell["Setup", "Section",ExpressionUUID->"5be52b1e-1468-bd48-8386-3fedd3074272"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"24369366-c59c-cf47-96c1-a6d9da3b5bd9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sourcePowerRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a1", "\[Rule]", "6"}], ",", 
     RowBox[{"a2", "\[Rule]", "6"}]}], "}"}]}], ";", 
  RowBox[{"sourcePowerVector", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"a1", ",", "a2"}], "}"}], "/.", "\[VeryThinSpace]", 
    "sourcePowerRule"}]}], ";", 
  RowBox[{"sourcePowerFileTag", "=", 
   RowBox[{"StringRiffle", "[", 
    RowBox[{
     RowBox[{"ToString", "/@", "sourcePowerVector"}], ",", "\"\<_\>\""}], 
    "]"}]}], ";", 
  RowBox[{"sourcePowerVarTag", "=", 
   RowBox[{"StringRiffle", "[", 
    RowBox[{
     RowBox[{"ToString", "/@", "sourcePowerVector"}], ",", "\"\<$\>\""}], 
    "]"}]}], ";", 
  RowBox[{"topTarget", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "1"}], "}"}]}], ";", 
  RowBox[{"typeIITarget", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}]}], ";", 
  RowBox[{"family", "=", 
   RowBox[{"CreateFeynmanIntegral", "[", 
    RowBox[{
     RowBox[{"\"\<LoopMomenta\>\"", "\[Rule]", 
      RowBox[{"{", "k1", "}"}]}], ",", 
     RowBox[{"\"\<ExternalMomenta\>\"", "\[Rule]", 
      RowBox[{"{", "p1", "}"}]}], ",", 
     RowBox[{"\"\<Propagators\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"SP", "[", 
          RowBox[{"k1", ",", "k1"}], "]"}], "-", "m1sq"}], ",", 
        RowBox[{
         RowBox[{"SP", "[", 
          RowBox[{
           RowBox[{"k1", "+", "p1"}], ",", 
           RowBox[{"k1", "+", "p1"}]}], "]"}], "-", "m2sq"}]}], "}"}]}], ",", 
     RowBox[{"\"\<AuxiliaryPropagators\>\"", "\[Rule]", 
      RowBox[{"{", "}"}]}], ",", 
     RowBox[{"\"\<KinematicRules\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"SP", "[", 
         RowBox[{"p1", ",", "p1"}], "]"}], "\[Rule]", "s"}], "}"}]}], ",", 
     RowBox[{"\"\<DimensionSymbol\>\"", "\[Rule]", "d"}]}], "]"}]}], ";", 
  RowBox[{"fireSourceFile", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"DirectoryName", "[", 
       RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ",", "\"\<tests\>\"", 
      ",", "\"\<fire_reference_cases\>\"", ",", "\"\<bubble_massive\>\"", 
      ",", "\"\<coefficients\>\"", ",", 
      RowBox[{"\"\<bubble_massive__src_\>\"", "<>", "sourcePowerFileTag", 
       "<>", "\"\<.wl\>\""}]}], "}"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"7ec32d85-6196-274f-8fbf-d28c02d6b280"],

Cell["Top Target {1, 1}", "Section",ExpressionUUID->"fcc7f6d4-099d-cf4c-adb4-29208d231da9"],

Cell["\<\
This step builds the generating function for the top target and returns the \
runtime.\
\>", "Text",ExpressionUUID->"26cd13cc-9193-9b47-b1ca-80100054d27b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tBuild1", ",", "gf1"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"BuildBaikovGeneratingFunction", "[", 
     RowBox[{"family", ",", "topTarget"}], "]"}], "]"}]}], ";", 
  "tBuild1"}]], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"b7a8f2c6-9e00-534d-a379-3508e8c692b8"],

Cell[BoxData["0.0035574`"], "Output",
 CellChangeTimes->{3.9868601344964333`*^9},
 CellLabel->"Out[55]=",ExpressionUUID->"35c394f9-f4de-994d-b0e4-9b22964afacb"]
}, Open  ]],

Cell["\<\
t$16 <-> D1 = -m1sq + SP[k1, k1]
t$17 <-> D2 = -m2sq + SP[k1, k1] + 2*SP[k1, p1] + SP[p1, p1]\
\>", "Text",ExpressionUUID->"49c50914-204e-b342-a52c-4d50fa30d1f5"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime.\
\>", "Text",ExpressionUUID->"c041e45c-fea4-af48-9f78-ce8aa36c984b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tExtract1", ",", "raw1"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"ExtractBaikovCoefficient", "[", 
     RowBox[{"gf1", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a1", ",", "a2"}], "}"}], "/.", "\[VeryThinSpace]", 
       "sourcePowerRule"}]}], "]"}], "]"}]}], ";", "tExtract1"}]], "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"9da7b01f-2fad-5645-b166-6ea0b8c5d1d2"],

Cell[BoxData["0.0031867`"], "Output",
 CellChangeTimes->{3.9868601345037346`*^9},
 CellLabel->"Out[56]=",ExpressionUUID->"fc8d7a44-2a7e-2340-b7e7-88788efe7415"]
}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime.\
\>", "Text",ExpressionUUID->"8f827ffa-be5e-cd4b-b15e-0fcb80d5ec68"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tSimplify1", ",", "res1"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"SimplifyBaikovCoefficient", "[", "raw1", "]"}], "]"}]}], ";", 
  "tSimplify1"}]], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"e7ee5ecb-f0f4-b249-a241-31f259f82835"],

Cell[BoxData["0.0037292`"], "Output",
 CellChangeTimes->{3.9868601345188046`*^9},
 CellLabel->"Out[57]=",ExpressionUUID->"6a876ae6-47f1-2647-b245-ee61fe79a5f5"]
}, Open  ]],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"9855faff-d3d7-f34a-bfc5-fb725ea86968"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tCompare1", ",", "compare1"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{
     RowBox[{"Get", "[", "fireSourceFile", "]"}], ";", 
     RowBox[{"fireCoeff1", "=", 
      RowBox[{"Symbol", "[", 
       RowBox[{"\"\<bubbleMassive$src$\>\"", "<>", "sourcePowerVarTag", 
        "<>", "\"\<$to$1$1\>\""}], "]"}]}], ";", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"Cancel", "[", 
        RowBox[{"Together", "[", 
         RowBox[{
          RowBox[{"res1", "[", "\"\<Coefficient\>\"", "]"}], "-", 
          "fireCoeff1"}], "]"}], "]"}], "\[Equal]", "0"}], "]"}]}], "]"}]}], ";", 
  RowBox[{"Association", "[", 
   RowBox[{
    RowBox[{"\"\<Time\>\"", "\[Rule]", "tCompare1"}], ",", 
    RowBox[{"\"\<MatchQ\>\"", "\[Rule]", "compare1"}]}], "]"}]}]], "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"9cf8e276-ee84-8d47-a9bd-3e0b716f068c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0517321`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9868601345749187`*^9},
 CellLabel->"Out[58]=",ExpressionUUID->"33406b5d-6bea-1943-a44c-b330b90ea8cf"]
}, Open  ]],

Cell["Representative TypeII Target {1, 0}", "Section",ExpressionUUID->"81d1610f-8587-7b4d-9136-0f050109e9a3"],

Cell["\<\
This step builds the generating function for a representative TypeII target \
and returns the runtime.\
\>", "Text",ExpressionUUID->"b35fcaef-7afc-3340-902c-8edbaf9a27ef"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tBuild2", ",", "gf2"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"BuildBaikovGeneratingFunction", "[", 
     RowBox[{"family", ",", "typeIITarget"}], "]"}], "]"}]}], ";", 
  "tBuild2"}]], "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"70f10c9a-cf61-f044-b016-f9300ce8f97e"],

Cell[BoxData["0.0030173`"], "Output",
 CellChangeTimes->{3.9868601345904007`*^9},
 CellLabel->"Out[59]=",ExpressionUUID->"994314b5-3013-ee46-b184-3934f6aebc3c"]
}, Open  ]],

Cell["\<\
t$18 <-> D1 = -m1sq + SP[k1, k1]
t$19 <-> D2 = -m2sq + SP[k1, k1] + 2*SP[k1, p1] + SP[p1, p1]\
\>", "Text",ExpressionUUID->"c9c6fac1-b62e-344a-a990-3aca566d4ed3"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime.\
\>", "Text",ExpressionUUID->"04c265c4-88d8-d744-ab72-9548416fe53c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tExtract2", ",", "raw2"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"ExtractBaikovCoefficient", "[", 
     RowBox[{"gf2", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a1", ",", "a2"}], "}"}], "/.", "\[VeryThinSpace]", 
       "sourcePowerRule"}]}], "]"}], "]"}]}], ";", "tExtract2"}]], "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"6bf98d6d-e25b-0348-a736-f1cef9c5d123"],

