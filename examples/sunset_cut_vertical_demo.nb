(* Beginning of Notebook Content *)
Notebook[{
Cell["Example: Vertical Sunset Cut", "Title",ExpressionUUID->"2173e864-90b3-ba43-86db-67fcb9c18eac"],

Cell["Load Package", "Section",ExpressionUUID->"d6fc5edb-fbe0-1545-b383-7c1f9bd2d288"],

Cell["\<\
This step loads the package and exposes the public interface used below.\
\>", "Text",ExpressionUUID->"8741d652-7ef0-8b42-a9a3-29e950c7bbee"],

Cell["\<\
Get[FileNameJoin[{DirectoryName@NotebookDirectory[], \"BaikovGF\", \
\"BaikovGF.wl\"}]];

Needs[\"BaikovGF`\"];\
\>", "Input",
 CellLabel->
  "In[190]:=",ExpressionUUID->"0f174cb5-9f81-f747-b945-5038054ca914"],

Cell["Setup", "Section",ExpressionUUID->"60e55ce4-932e-4f40-b9b6-a68f1825d9c5"],

Cell["\<\
This step fixes the source-power rule, target powers, and integral-family \
object for the example.\
\>", "Text",ExpressionUUID->"a45de03b-5be3-7241-b15f-d496e3589595"],

Cell["\<\
(* Fix the numeric source powers used in this example. *)
sourcePowerRule = {a1 -> 2, a2 -> 2, a3 -> 2, a4 -> 2, a5 -> 3};

(* Build helper forms of the source powers from sourcePowerRule. *)
sourcePowerVectorPackage = {a1, a2, a3, a4, a5} /. sourcePowerRule;
sourcePowerVector = sourcePowerVectorPackage;
sourcePowerFileTag = StringRiffle[ToString /@ sourcePowerVector, \"_\"];
sourcePowerVarTag = StringRiffle[ToString /@ sourcePowerVector, \"$\"];

(* Set the powers for target1. *)
target1 = {1, 1, 1, 1, 0};

(* Build the Feynman-integral family object with loop momenta {k1, k2}, \
external momenta {p1}, explicit propagators {SP[k1, k1], SP[k1 - p1, k1 - \
p1], SP[k2, k2], SP[k2 - p1, k2 - p1], SP[k1 - k2, k1 - k2]}, no auxiliary \
propagators, kinematic rules {SP[p1, p1] -> s}, and dimension symbol d. *)
family = CreateFeynmanIntegral[
  \"LoopMomenta\" -> {k1, k2},
  \"ExternalMomenta\" -> {p1},
  \"Propagators\" -> {SP[k1, k1], SP[k1 - p1, k1 - p1], SP[k2, k2], SP[k2 - \
p1, k2 - p1], SP[k1 - k2, k1 - k2]},
  \"AuxiliaryPropagators\" -> {},
  \"KinematicRules\" -> {SP[p1, p1] -> s},
  \"DimensionSymbol\" -> d
];

(* Point to the FIRE coefficient file for this source powers. *)
fireSourceFile = FileNameJoin[{DirectoryName@NotebookDirectory[], \"tests\", \
\"fire_reference_cases\", \"sunset_cut_vertical\", \"coefficients\", \
\"sunset_cut_vertical__src_\" <> sourcePowerFileTag <> \".wl\"}];\
\>", "Input",
 CellLabel->
  "In[193]:=",ExpressionUUID->"7c4bd222-81d0-594f-8a0d-529c930637bc"],

Cell["Representative TypeIII Target {1, 1, 1, 1, 0}", "Section",ExpressionUUID->"5cfd34b3-14b3-a445-b2b8-a7ebbe216e60"],

Cell["\<\
This step builds the generating-function object for the selected target and \
returns the runtime after evaluation.\
\>", "Text",ExpressionUUID->"c2254d4a-beae-1b4b-b6a7-a4d0d4e73f5c"],

Cell[CellGroupData[{

Cell["\<\
{tBuild1, gf1} = BuildBaikovGeneratingFunction[family, target1] // \
AbsoluteTiming;
tBuild1\
\>", "Input",
 CellLabel->
  "In[210]:=",ExpressionUUID->"dae4e81d-e286-8444-abb6-1c709dbace2c"],

Cell[BoxData["0.0253861`"], "Output",
 CellChangeTimes->{3.9868603618122616`*^9},
 CellLabel->
  "Out[211]=",ExpressionUUID->"86b6f0b0-671f-6942-81bb-13a7c3deda9d"]
}, Open  ]],

Cell["\<\
t$24 <-> D1 = SP[k1, k1]
t$25 <-> D2 = SP[k1, k1] - 2*SP[k1, p1] + SP[p1, p1]
t$26 <-> D3 = SP[k2, k2]
t$27 <-> D4 = SP[k2, k2] - 2*SP[k2, p1] + SP[p1, p1]
t$28 <-> D5 = SP[k1, k1] - 2*SP[k1, k2] + SP[k2, k2]\
\>", "Text",ExpressionUUID->"e293ad05-8286-a643-bd57-a7cbd1d0a991"],

Cell["\<\
This step extracts the unsimplified coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"f080c60c-60a6-5940-87b7-a92ac4a0c451"],

Cell[CellGroupData[{

Cell["\<\
{tExtract1, raw1} = ExtractBaikovCoefficient[gf1, sourcePowerVectorPackage] \
// AbsoluteTiming;
tExtract1\
\>", "Input",
 CellLabel->
  "In[212]:=",ExpressionUUID->"96dfd788-1487-a641-b3e4-f2024ce71dc2"],

Cell[BoxData["0.0028639`"], "Output",
 CellChangeTimes->{3.9868603618255405`*^9},
 CellLabel->
  "Out[213]=",ExpressionUUID->"5655541f-71ec-9549-b616-de3f91110ab5"]
}, Open  ]],

Cell["\<\
This step simplifies the extracted coefficient and returns the runtime after \
evaluation.\
\>", "Text",ExpressionUUID->"d6625c30-9582-f14a-b173-4587cb3dedcc"],

Cell[CellGroupData[{

Cell["\<\
{tSimplify1, res1} = SimplifyBaikovCoefficient[raw1] // AbsoluteTiming;
tSimplify1\
\>", "Input",
 CellLabel->
  "In[214]:=",ExpressionUUID->"5230bed6-abc8-9c41-adf9-00f08113a872"],

Cell[BoxData["0.0009087`"], "Output",
 CellChangeTimes->{3.986860361829054*^9},
 CellLabel->
  "Out[215]=",ExpressionUUID->"453f9187-e099-b140-a98c-660f4231c364"]
}, Open  ]],

Cell["Compare to FIRE", "Subsection",ExpressionUUID->"b2ba1752-fb85-9547-8f6b-38335513aaac"],

Cell[CellGroupData[{

Cell["\<\
{tCompare1, compare1} = (
  Get[fireSourceFile];
  fireCoeff1 = Symbol[\"sunsetCutVertical$src$\" <> sourcePowerVarTag <> \
\"$to$1$1$1$1$0\"];
  Simplify[Cancel[Together[res1[\"Coefficient\"] - fireCoeff1]] == 0]
) // AbsoluteTiming;
<|\"Time\" -> tCompare1, \"MatchQ\" -> compare1|>\
\>", "Input",
 CellLabel->
  "In[216]:=",ExpressionUUID->"d9fe3b8d-33e4-2448-a542-4ae019e670b0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Time\"\>", "\[Rule]", "0.0016281`"}], ",", 
   RowBox[{"\<\"MatchQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.986860361833042*^9},
 CellLabel->
  "Out[217]=",ExpressionUUID->"a028f682-981f-b045-94cf-d7c7197b21aa"]
}, Open  ]]
},
WindowSize->{1440, 778.5},
WindowMargins->{{-4.875, Automatic}, {Automatic, -4.875}},
WindowTitle->"Example: Vertical Sunset Cut",
Magnification:>1.1 Inherited,
