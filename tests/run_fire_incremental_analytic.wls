(* ::Package:: *)

(* Reusable analytic regression runner against the FIRE reference tables.
   Outputs:
   - tests/results/fire_incremental_analytic/results.wl
   - tests/results/fire_incremental_analytic/summary.en.md
   - tests/results/fire_incremental_analytic/summary.zh.md
*)

scriptPath = ExpandFileName[$InputFileName];
testsDir = DirectoryName[scriptPath];
projectRoot = DirectoryName[testsDir];
packagePath = FileNameJoin[{projectRoot, "BaikovGF", "BaikovGF.wl"}];
fireRoot = FileNameJoin[{testsDir, "fire_reference_cases"}];
reportRoot = FileNameJoin[{testsDir, "results", "fire_incremental_analytic"}];
resultsFile = FileNameJoin[{reportRoot, "results.wl"}];
summaryFileEn = FileNameJoin[{reportRoot, "summary.en.md"}];
summaryFileZh = FileNameJoin[{reportRoot, "summary.zh.md"}];

If[!FileExistsQ[packagePath],
  Print["Package file not found: " <> packagePath];
  Exit[1];
];
If[!DirectoryQ[fireRoot],
  Print["FIRE reference directory not found: " <> fireRoot];
  Exit[1];
];
If[!DirectoryQ[reportRoot],
  CreateDirectory[reportRoot, CreateIntermediateDirectories -> True]
];

Get[packagePath];

writeWL[path_String, expr_] := Export[path, ToString[InputForm[expr]] <> "\n", "Text"];

resetBaikovCaches[] := Module[{},
  Quiet @ Check[BaikovGF`Private`$enablePersistentBaikovCache = False, Null];
  Quiet @ Check[BaikovGF`Private`$internalFamilyDataCache = <||>, Null];
  Quiet @ Check[BaikovGF`Private`$residueDataCache = <||>, Null];
  Quiet @ Check[BaikovGF`Private`$topGFCache = <||>, Null];
  Quiet @ Check[BaikovGF`Private`$gfObjectCache = <||>, Null];
  Quiet @ Check[BaikovGF`Private`$typeIIStateCache = <||>, Null];
  Quiet @ Check[BaikovGF`Private`$rawCoefficientCache = <||>, Null];
  Quiet @ Check[BaikovGF`Private`$simplifiedCoefficientCache = <||>, Null];
  ClearSystemCache[];
];

resetBaikovCaches[];

formatPowers[powers_List] := "{" <> StringRiffle[ToString /@ powers, ", "] <> "}";

caseKey[slug_String, source_List, target_List] :=
  slug <> " | " <> ToString[source, InputForm] <> " | " <> ToString[target, InputForm];

resultSortKey[row_Association] := {
  Lookup[row, "Slug", ""],
  ToString[Lookup[row, "Source", {}], InputForm],
  ToString[Lookup[row, "Target", {}], InputForm]
};

loadExistingResults[] := Module[{data},
  If[!FileExistsQ[resultsFile], Return[<||>]];
  data = Quiet @ Check[Get[resultsFile], <||>];
  If[AssociationQ[data], data, <||>]
];

saveResults[resultAssoc_Association] := writeWL[resultsFile, resultAssoc];

statusCounts[resultAssoc_Association] := Counts[Lookup[#, "Status"] & /@ Values[resultAssoc]];

renderSummaryEn[resultAssoc_Association] := Module[{rows, counts, lines},
  rows = SortBy[Values[resultAssoc], resultSortKey];
  counts = statusCounts[resultAssoc];
  lines = Join[
    {
      "# FIRE Analytic Regression",
      "",
      "Generated by `tests/run_fire_incremental_analytic.wls`.",
      "",
      "## Status counts",
      "",
      "| Status | Count |",
      "| --- | ---: |"
    },
    ( "| " <> ToString[#[[1]]] <> " | " <> ToString[#[[2]]] <> " |" & /@ SortBy[Normal[counts], First]),
    {
      "",
      "## Per-case results",
      "",
      "| Slug | Source | Target | Type | PackageTime(s) | Status | Note |",
      "| --- | --- | --- | --- | ---: | --- | --- |"
    },
    (
      "| " <> Lookup[#, "Slug", ""] <> " | " <>
      formatPowers[Lookup[#, "Source", {}]] <> " | " <>
      formatPowers[Lookup[#, "Target", {}]] <> " | " <>
      ToString[Lookup[#, "Type", ""]] <> " | " <>
      ToString @ NumberForm[Lookup[#, "PackageTime", 0.], {Infinity, 3}] <> " | " <>
      Lookup[#, "Status", ""] <> " | " <>
      StringReplace[Lookup[#, "Note", ""], "|" -> "\\|"] <> " |"
    ) & /@ rows
  ];
  StringRiffle[lines, "\n"] <> "\n"
];

renderSummaryZh[resultAssoc_Association] := Module[{rows, counts, lines},
  rows = SortBy[Values[resultAssoc], resultSortKey];
  counts = statusCounts[resultAssoc];
  lines = Join[
    {
      "# FIRE \:89e3\:6790\:56de\:5f52\:6d4b\:8bd5",
      "",
      "\:7531 `tests/run_fire_incremental_analytic.wls` \:81ea\:52a8\:751f\:6210\:3002",
      "",
      "## \:72b6\:6001\:7edf\:8ba1",
      "",
      "| \:72b6\:6001 | \:6570\:91cf |",
      "| --- | ---: |"
    },
    ( "| " <> ToString[#[[1]]] <> " | " <> ToString[#[[2]]] <> " |" & /@ SortBy[Normal[counts], First]),
    {
      "",
      "## \:9010\:4f8b\:7ed3\:679c",
      "",
      "| \:56fe\:65cf | \:6e90\:5e42\:6b21 | \:76ee\:6807\:5e42\:6b21 | \:7c7b\:578b | \:5305\:65f6\:95f4(s) | \:72b6\:6001 | \:5907\:6ce8 |",
      "| --- | --- | --- | --- | ---: | --- | --- |"
    },
    (
      "| " <> Lookup[#, "Slug", ""] <> " | " <>
      formatPowers[Lookup[#, "Source", {}]] <> " | " <>
      formatPowers[Lookup[#, "Target", {}]] <> " | " <>
      ToString[Lookup[#, "Type", ""]] <> " | " <>
      ToString @ NumberForm[Lookup[#, "PackageTime", 0.], {Infinity, 3}] <> " | " <>
      Lookup[#, "Status", ""] <> " | " <>
      StringReplace[Lookup[#, "Note", ""], "|" -> "\\|"] <> " |"
    ) & /@ rows
  ];
  StringRiffle[lines, "\n"] <> "\n"
];

saveSummaries[resultAssoc_Association] := Module[{},
  Export[summaryFileEn, renderSummaryEn[resultAssoc], "Text"];
  Export[summaryFileZh, renderSummaryZh[resultAssoc], "Text"];
];

reorderByAux[v_List, auxSlots_List] :=
  If[auxSlots === {}, v, Join[Delete[v, List /@ auxSlots], v[[auxSlots]]]];

supportedTargetQ[target_List, auxSlots_List] := Module[{n = Length[target], nAux = Length[auxSlots]},
  If[nAux > 0,
    target === Join[ConstantArray[1, n - nAux], ConstantArray[0, nAux]],
    target === ConstantArray[1, n] ||
      (VectorQ[target, (# === 0 || # === 1) &] && Count[target, 0] == 1 && Count[target, 1] == n - 1)
  ]
];

buildFamilyFromSpec[spec_Association] := Module[{allProps, auxSlots, explicit, auxiliary},
  allProps = spec["Propagators"];
  auxSlots = Lookup[spec, "AuxiliarySlots", {}];
  explicit = If[auxSlots === {}, allProps, Delete[allProps, List /@ auxSlots]];
  auxiliary = If[auxSlots === {}, {}, allProps[[auxSlots]]];
  CreateFeynmanIntegral[
    "LoopMomenta" -> spec["LoopMomenta"],
    "ExternalMomenta" -> spec["ExternalMomenta"],
    "Propagators" -> explicit,
    "AuxiliaryPropagators" -> auxiliary,
    "KinematicRules" -> spec["KinematicRules"],
    "DimensionSymbol" -> d
  ]
];

pilotCases = {
  <|"Slug" -> "self_energy_3loop_1ext", "Source" -> {1, 1, 1, 0, 1, 1, 1, 1, 2}, "Target" -> {1, 1, 1, 0, 1, 1, 1, 1, 1}|>,
  <|"Slug" -> "sunset_4prop", "Source" -> {1, 0, 1, 1, 2}, "Target" -> {1, 0, 1, 1, 1}|>,
  <|"Slug" -> "bubble_massive", "Source" -> {4, 5}, "Target" -> {0, 1}|>,
  <|"Slug" -> "vacuum_2loop", "Source" -> {2, 2, 3}, "Target" -> {0, 1, 1}|>,
  <|"Slug" -> "sunset_cut_vertical", "Source" -> {2, 2, 2, 2, 2}, "Target" -> {1, 1, 1, 1, 0}|>,
  <|"Slug" -> "hq_potential_2loop", "Source" -> {1, 1, 2, 2, 2, 2, 1}, "Target" -> {1, 1, 1, 1, 0, 1, 1}|>
};
pilotCaseKeys = caseKey @@@ ({#["Slug"], #["Source"], #["Target"]} & /@ pilotCases);

parseArguments[args_List] := Module[
  {
    force = False,
    pilot = False,
    rerunNonAnalytic = False,
    caseBudgetSeconds = 1200,
    maxCases = Infinity,
    slugs = {},
    i = 1,
    arg
  },
  While[i <= Length[args],
    arg = args[[i]];
    Switch[arg,
      "--force",
        force = True;
        i++,
      "--pilot",
        pilot = True;
        i++,
      "--rerun-non-analytic",
        rerunNonAnalytic = True;
        i++,
      "--help",
        Print["Usage: wolframscript -script tests/run_fire_incremental_analytic.wls [--pilot] [--force] [--rerun-non-analytic] [--case-budget-seconds N] [--max-cases N] [slug1 slug2 ...]"];
        Exit[0],
      "--case-budget-seconds",
        If[i == Length[args],
          Print["Missing integer after --case-budget-seconds"];
          Exit[1];
        ];
        caseBudgetSeconds = ToExpression[args[[i + 1]]];
        If[!IntegerQ[caseBudgetSeconds] || caseBudgetSeconds <= 0,
          Print["--case-budget-seconds expects a positive integer."];
          Exit[1];
        ];
        i += 2,
      "--max-cases",
        If[i == Length[args],
          Print["Missing integer after --max-cases"];
          Exit[1];
        ];
        maxCases = ToExpression[args[[i + 1]]];
        If[!IntegerQ[maxCases] || maxCases <= 0,
          Print["--max-cases expects a positive integer."];
          Exit[1];
        ];
        i += 2,
      _,
        AppendTo[slugs, arg];
        i++
    ]
  ];
  <|
    "Force" -> force,
    "Pilot" -> pilot,
    "RerunNonAnalytic" -> rerunNonAnalytic,
    "CaseBudgetSeconds" -> caseBudgetSeconds,
    "MaxCases" -> maxCases,
    "RequestedSlugs" -> DeleteDuplicates[slugs]
  |>
];

rawCommandLineArgs = Select[
  $ScriptCommandLine,
  MemberQ[{"-file", "-f", "-script"}, #] === False &&
    (Quiet @ Check[ExpandFileName[#], #] =!= scriptPath) &
];
options = parseArguments[rawCommandLineArgs];

allSlugs = Sort @ (FileNameTake /@ Select[FileNames["*", fireRoot], DirectoryQ[#] && FileNameTake[#] =!= "scripts" &]);
selectedSlugs = If[options["RequestedSlugs"] === {}, allSlugs, Select[allSlugs, MemberQ[options["RequestedSlugs"], #] &]];

runSupportedCase[slug_String, auxSlots_List, family_Association, sourcePowers_List, targetPowers_List, reference_, caseBudgetSeconds_Integer] := Module[
  {
    sourcePkg,
    targetPkg,
    gf,
    raw,
    res,
    calc,
    compare,
    type = "",
    status,
    note = "",
    gfTime = 0.,
    extTime = 0.,
    simTime = 0.,
    packageTime = 0.,
    caseStart,
    deadline,
    remainingSeconds
  },
  caseStart = AbsoluteTime[];
  deadline = caseStart + N[caseBudgetSeconds];
  remainingSeconds[] := Max[0.1, deadline - AbsoluteTime[]];

  sourcePkg = reorderByAux[sourcePowers, auxSlots];
  targetPkg = reorderByAux[targetPowers, auxSlots];

  gfTime = AbsoluteTiming[
    gf = TimeConstrained[BuildBaikovGeneratingFunction[family, targetPkg], remainingSeconds[], $Aborted];
  ][[1]];
  packageTime += gfTime;
  If[gf === $Aborted,
    Return[<|"Slug" -> slug, "Source" -> sourcePowers, "Target" -> targetPowers, "Type" -> "", "PackageTime" -> packageTime, "Status" -> "gf-timeout", "Note" -> "Generating function timed out within the per-case budget."|>]
  ];
  If[FailureQ[gf],
    Return[<|"Slug" -> slug, "Source" -> sourcePowers, "Target" -> targetPowers, "Type" -> "", "PackageTime" -> packageTime, "Status" -> "gf-failure", "Note" -> ToString[gf, InputForm]|>]
  ];
  type = Lookup[gf, "Type", ""];

  extTime = AbsoluteTiming[
    raw = TimeConstrained[ExtractBaikovCoefficient[gf, sourcePkg], remainingSeconds[], $Aborted];
  ][[1]];
  packageTime += extTime;
  If[raw === $Aborted,
    Return[<|"Slug" -> slug, "Source" -> sourcePowers, "Target" -> targetPowers, "Type" -> type, "PackageTime" -> packageTime, "Status" -> "extract-timeout", "Note" -> "Coefficient extraction timed out within the per-case budget."|>]
  ];
  If[FailureQ[raw],
    Return[<|"Slug" -> slug, "Source" -> sourcePowers, "Target" -> targetPowers, "Type" -> type, "PackageTime" -> packageTime, "Status" -> "extract-failure", "Note" -> ToString[raw, InputForm]|>]
  ];

  simTime = AbsoluteTiming[
    res = TimeConstrained[SimplifyBaikovCoefficient[raw], remainingSeconds[], $Aborted];
  ][[1]];
  packageTime += simTime;
  If[res === $Aborted,
    Return[<|"Slug" -> slug, "Source" -> sourcePowers, "Target" -> targetPowers, "Type" -> type, "PackageTime" -> packageTime, "Status" -> "simplify-timeout", "Note" -> "Coefficient simplification timed out within the per-case budget."|>]
  ];
  If[FailureQ[res],
    Return[<|"Slug" -> slug, "Source" -> sourcePowers, "Target" -> targetPowers, "Type" -> type, "PackageTime" -> packageTime, "Status" -> "simplify-failure", "Note" -> ToString[res, InputForm]|>]
  ];

  calc = res["Coefficient"];
  If[AbsoluteTime[] >= deadline,
    Return[<|"Slug" -> slug, "Source" -> sourcePowers, "Target" -> targetPowers, "Type" -> type, "PackageTime" -> packageTime, "Status" -> "compare-timeout", "Note" -> "Package finished, but the per-case budget was exhausted before analytic comparison."|>]
  ];

  compare = TimeConstrained[
    Quiet @ Simplify[Cancel[Together[calc - reference]] == 0],
    remainingSeconds[],
    $Aborted
  ];

  status = Which[
    TrueQ[compare], "analytic-ok",
    compare === $Aborted, "compare-timeout",
    compare === False, "mismatch",
    True, "case-error"
  ];

  note = Switch[status,
    "analytic-ok", "",
    "compare-timeout", "Analytic comparison to the FIRE coefficient timed out within the per-case budget.",
    "mismatch", "The package coefficient does not match the FIRE reference coefficient analytically.",
    "case-error", "Unexpected comparison result: " <> ToString[compare, InputForm],
    _, ""
  ];

  <|
    "Slug" -> slug,
    "Source" -> sourcePowers,
    "Target" -> targetPowers,
    "Type" -> type,
    "PackageTime" -> packageTime,
    "Status" -> status,
    "Note" -> note
  |>
];

existingResults = loadExistingResults[];
saveSummaries[existingResults];

executedCount = 0;

processCase[resultAssoc_Association, row_Association] := Module[{updated = resultAssoc, key},
  key = caseKey[row["Slug"], row["Source"], row["Target"]];
  updated[key] = row;
  saveResults[updated];
  saveSummaries[updated];
  updated
];

shouldRunCaseQ[slug_String, source_List, target_List] := Module[{key, keepByPilot, existingRow, keepByStatus, keepByExisting},
  key = caseKey[slug, source, target];
  existingRow = Lookup[existingResults, key, Missing["NotFound"]];
  keepByPilot = If[TrueQ[options["Pilot"]], MemberQ[pilotCaseKeys, key], True];
  keepByStatus = If[
    TrueQ[options["RerunNonAnalytic"]],
    existingRow =!= Missing["NotFound"] && Lookup[existingRow, "Status", ""] =!= "analytic-ok",
    True
  ];
  keepByExisting = If[
    TrueQ[options["RerunNonAnalytic"]],
    True,
    TrueQ[options["Force"]] || !KeyExistsQ[existingResults, key]
  ];
  keepByPilot && keepByStatus && keepByExisting && executedCount < options["MaxCases"]
];

Do[
  Module[
    {specPath, indexPath, spec, index, auxSlots, family, sourceEntries, masterEntries, sourcePowers, targetPowers, row},
    If[executedCount >= options["MaxCases"], Break[]];

    specPath = FileNameJoin[{fireRoot, slug, slug <> "_family.wl"}];
    indexPath = FileNameJoin[{fireRoot, slug, slug <> "_index.wl"}];
    spec = Get[specPath];
    index = Get[indexPath];
    auxSlots = Lookup[spec, "AuxiliarySlots", {}];
    family = buildFamilyFromSpec[spec];

    If[FailureQ[family],
      row = <|
        "Slug" -> slug,
        "Source" -> {},
        "Target" -> {},
        "Type" -> "",
        "PackageTime" -> 0.,
        "Status" -> "family-failure",
        "Note" -> ToString[family, InputForm]
      |>;
      existingResults = processCase[existingResults, row];
      Continue[];
    ];

    sourceEntries = SortBy[Values[index["Sources"]], ToString[Lookup[#, "SourcePowers", {}], InputForm] &];
    Do[
      sourcePowers = sourceEntry["SourcePowers"];
      masterEntries = SortBy[Values[sourceEntry["MasterCoefficients"]], ToString[Lookup[#, "MasterPowers", {}], InputForm] &];
      Do[
        targetPowers = masterEntry["MasterPowers"];
        If[!supportedTargetQ[reorderByAux[targetPowers, auxSlots], auxSlots], Continue[]];
        If[!shouldRunCaseQ[slug, sourcePowers, targetPowers], Continue[]];

        Print["Running: " <> slug <> " " <> ToString[sourcePowers, InputForm] <> " -> " <> ToString[targetPowers, InputForm]];
        resetBaikovCaches[];
        row = Quiet @ Check[
          runSupportedCase[slug, auxSlots, family, sourcePowers, targetPowers, masterEntry["Coefficient"], options["CaseBudgetSeconds"]],
          <|
            "Slug" -> slug,
            "Source" -> sourcePowers,
            "Target" -> targetPowers,
            "Type" -> "",
            "PackageTime" -> 0.,
            "Status" -> "case-error",
            "Note" -> "Unexpected exception during case execution."
          |>
        ];
        existingResults = processCase[existingResults, row];
        executedCount++;
        If[executedCount >= options["MaxCases"], Break[]],
        {masterEntry, masterEntries}
      ];
      If[executedCount >= options["MaxCases"], Break[]],
      {sourceEntry, sourceEntries}
    ];
  ],
  {slug, selectedSlugs}
];

Print["English summary: " <> summaryFileEn];
Print["Chinese summary: " <> summaryFileZh];
Print["Results file: " <> resultsFile];
Print["New cases executed this run: " <> ToString[executedCount]];
Print[statusCounts[existingResults] // InputForm];
